# Project-wide shellcheck configuration.

# Disable warnings that produce noise without bug-finding value in this
# codebase:
#
# SC2154 - vars referenced but not assigned. make-helper-one.bsh runs in the
# scope of its entrypoint make-helper.bsh (which sets first_arch etc.) and
# sources helper-scripts (parallel.bsh sets parallel_failures) via runtime
# $HELPER_SCRIPTS_PATH paths shellcheck cannot follow, so these read as unset.
#
# SC2034 - vars assigned but appear unused. Arrays like push_label are consumed
# by name via parallel_wait (a nameref), which shellcheck cannot see.
#
# SC1090 - "Can't follow non-constant source." Unavoidable wherever source
# paths are computed from $HELPER_SCRIPTS_PATH / $BASH_SOURCE.
#
# SC1091 - "Not following: file not included". Same reason.
disable=SC2154
disable=SC2034
disable=SC1090
disable=SC1091
