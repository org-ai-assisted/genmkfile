#!/bin/bash

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## style-ok: no-strict
## Sourced-only function library (make-helper.bsh sources it); it must not set
## strict-mode, which would leak 'errexit'/'nounset'/'pipefail' into the
## sourcing shell.
## style-ok: no-has -- the two 'command -v' uses below RESOLVE a command's
## path (has returns only a boolean); this library runs before helper-scripts.

#set -x

## Code duplication. Copied from
## helper-scripts//usr/libexec/helper-scripts/has.sh.
##
## Because has.sh cannot be sources here (the build host may not have
## helper-scripts installed).
has() {
  local _cmd _name

  for _name in "$@"; do
    _cmd="$(command -v "${_name}")" 2>/dev/null || return 1
    [ -x "${_cmd}" ] || return 1
  done
}

## Code duplication. Copied from
## helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh.
##
## Because check_runtime.bsh cannot be sourced here, see above.
was_executed() {
  local caller_bash_source_zero="${1}"
  if [[ "${caller_bash_source_zero}" == "${0}" ]] ||
    [[ "${caller_bash_source_zero}" == "$(command -v "${0}")" ]]; then
    return 0
  fi
  return 1
}
if [ "${GENMKFILE_DEBUG:-}" = "1" ]; then
  set -x
fi

make_output_info() {
  printf "%s\n" "${0}: ${cyan:-}[${make_source_package_name:-${PWD##*/}}]${reset:-} ${green}INFO:${reset} ${*}"
}

make_output_warn() {
  printf "%s\n" "${0}: ${cyan:-}[${make_source_package_name:-${PWD##*/}}]${reset:-} ${red}WARNING:${reset} ${*}" >&2
}

make_output_cached() {
  printf "%s\n" "${0}: ${cyan:-}[${make_source_package_name:-${PWD##*/}}]${reset:-} ${green}CACHED:${reset} ${*}"
}

make_output_debug() {
  printf "%s\n" "${0}: ${cyan:-}[${make_source_package_name:-${PWD##*/}}]${reset:-} ${green}DEBUG:${reset} ${*}"
}

make_log_and_run() {
  printf "%s\n" "${0}: ${cyan:-}[${make_source_package_name:-${PWD##*/}}]${reset:-} ${green}running:${reset} ${*}"
  "${@}"
}

make_output_error() {
  local trace
  # shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/trace.bsh
  source "${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/trace.bsh" || true
  ## override in case 'function_trace' unavailable.
  trace="$(function_trace)" || true
  printf "%s\n" "${0}: ${cyan:-}[${make_source_package_name:-${PWD##*/}}]${reset:-} ${red}${bold}ERROR:${reset} ${*}" >&2
  printf "%s\n" "${trace}" >&2
}

exit_with_error() {
  ## First arg is the exit code (every call site passes one); the rest is the message.
  ## Without the shift it leaked into make_output_error as a spurious leading token
  ## ("ERROR: 1 <msg>") and the code was ignored.
  local exit_code="$1"
  shift
  make_output_error "${@}"
  ## A fatal error must never report SUCCESS: a non-numeric code, 0, or a value outside
  ## 1..255 (which 'exit' would wrap mod 256, so 256 -> 0) falls back to 1.
  case "${exit_code}" in
    '' | *[!0-9]* )
      exit_code=1
      ;;
  esac
  if [ "${exit_code}" -lt 1 ] || [ "${exit_code}" -gt 255 ]; then
    exit_code=1
  fi
  exit "${exit_code}"
}

make_require() {
  local cmd
  for cmd in "${@}"; do
    if ! has "${cmd}"; then
      make_output_error "required command '${cmd}' not found in PATH.
If '${cmd}' is listed in debian/control, try:
  sudo genmkfile deb-build-dep"
      exit 1
    fi
  done
}

## Validate DEBEMAIL / DEBFULLNAME. The matching tools (debsign,
## debchange, sq, sq-git, git, bc, ...) are 'make_require'd at each
## individual call site rather than lumped together here, so failing a
## target only blocks on the tools that target actually needs.
deb_variables_check() {
  if [ -z "${DEBEMAIL:-}" ]; then
    ## Otherwise e-mail address in debian/changelog would default to
    ## user@host.localdomain and then lintian would complain and exit with
    ## failure code.
    exit_with_error 1 "environment variable DEBEMAIL may not be empty! Both, DEBEMAIL and DEBFULLNAME need to be set!"
  fi
  if [ -z "${DEBFULLNAME:-}" ]; then
    exit_with_error 1 "environment variable DEBFULLNAME may not be empty! Both, DEBEMAIL and DEBFULLNAME need to be set!"
  fi

  ## TODO: DEBSIGN_KEYID ?
}

make_init() {
  local pwd dirname_pwd parent_folder

  ## For manual invocation.
  ## Should be set by makefile already.
  [ -n "${GENMKFILE_PATH:-}" ] || GENMKFILE_PATH="/usr/share/genmkfile"
  export GENMKFILE_PATH

  pwd="${PWD}"
  ## Example pwd:
  ## ~/derivative-maker/packages/kicksecure/genmkfile
  dirname_pwd="$(dirname -- "${pwd}")"
  ## Example dirname_pwd:
  ## ~/derivative-maker/packages/kicksecure
  parent_folder="$(basename -- "${dirname_pwd}")"
  ## Example parent_folder:
  ## kicksecure
  derivative_repository_name="${parent_folder}"
  ## derivative_repository_name is read by dm-reprepro-wrapper
  export derivative_repository_name

  ## No longer in use.
  #pushd "$GENMKFILE_ROOT_DIR" >/dev/null

  genmkfile_temp_dir="$(mktemp --directory)"
}

make_deinit() {
  make_require safe-rm
  safe-rm --recursive --force -- "${genmkfile_temp_dir}"
}

make_parse_cmd() {
  ## Thanks to:
  ## http://mywiki.wooledge.org/BashFAQ/035

  local matched="false" arg target_fn

  while [ $# -gt 0 ]; do
    arg="$1"
    case "${arg}" in
    --)
      true "$0: end-of-options"
      shift
      break
      ;;
    -*)
      exit_with_error 1 "unknown option: ${arg}"
      ;;
    esac

    ## Targets map to 'make_<target with dashes -> underscores>'.
    ## If no such function exists, fall through to the trailing
    ## block which either defaults to make_all or tries to call
    ## the argument as a function name directly.
    target_fn="make_${arg//-/_}"
    if ! declare -F "${target_fn}" >/dev/null 2>&1; then
      true "$0: positional parameter: $*"
      break
    fi

    matched="true"
    if [ "${arg}" = "all" ]; then
      ## 'all' uniquely forwards the remaining CLI args to
      ## make_all, which passes them through to
      ## 'make -f Makefile_orig all "$@"'. This is what lets
      ## 'genmkfile all VAR=value' propagate VAR=value to the
      ## underlying 'make' invocation.
      shift
      make_function_run "${target_fn}" "$@"
      ## Args were forwarded; consume the rest so the loop
      ## terminates.
      set --
    else
      make_function_run "${target_fn}"
      shift
    fi
  done

  ## If there are input files (for example) that follow the options, they
  ## will remain in the "$@" positional parameters.

  if [ $# -eq 0 ] && [ "${matched}" != "true" ]; then
    make_function_run make_all
    return 0
  fi

  ## A valid target ran, then the loop broke on an argument that is NOT a target. It was
  ## previously dropped SILENTLY -- 'genmkfile install deb-cleanuptypo' installed and reported
  ## success while never running the misspelled target. Fail loud instead. (A run of purely
  ## VALID targets leaves nothing here; 'all' consumes its trailing args itself.)
  if [ "${matched}" = "true" ] && [ $# -gt 0 ]; then
    exit_with_error 1 "unrecognized target '$1' (every argument must be a genmkfile target; run 'genmkfile help')"
  fi

  ## An unrecognized FIRST argument reached here (no valid target ran). Do NOT
  ## fall through to running it -- make_function_run would exec it as a command,
  ## so a mistyped target that happens to name a PATH binary ('genmkfile rm ...',
  ## 'genmkfile id') would EXECUTE it. Fail loud, same as the 2nd-arg case above.
  if ! [ "${matched}" = "true" ]; then
    exit_with_error 1 "unrecognized target '$1' (every argument must be a genmkfile target; run 'genmkfile help')"
  fi
}

make_dependencies_filter_helper() {
  local temp
  ## Read a Debian dependency expression on stdin, write a clean space-separated package name
  ## list to stdout. Strips (all via sed, so the whole stream is covered, not a fixed list):
  ##   - commas (separator)
  ##   - version constraints '(>= 1.0)'
  ##   - architecture qualifiers '[linux-any]' / '[!linux-any]'
  ##   - build-profile restrictions '<!nocheck>'
  ##   - substitution markers '${shlibs:Depends}' and any other '${...}'
  ## and reduces '|' to a SPACE (not empty, so a space-less 'A|B' tokenizes as two names).
  ## NOTE: an 'A | B' alternative keeps BOTH names, not just the first. Reducing it to the
  ## first alternative correctly needs a real Debian-dependency parser -- folding may occur
  ## anywhere, alternatives carry per-arch and build-profile qualifiers, and grep-dctrl packs
  ## multiple binary stanzas newline-separated -- so a bash reimplementation reliably regresses
  ## one of those. Kept flat and simple on purpose (see the git skill's no-bash-parser rule).
  temp="$(sed \
    -e 's/,/ /g' \
    -e 's/([^)]*)//g' \
    -e 's/\[[^]]*\]//g' \
    -e 's/<[^>]*>//g' \
    -e 's/\${[^}]*}//g' \
    -e 's/|/ /g')"
  printf "%s\n" "${temp}"
}

## Parse Build-Depends and Depends from debian/control. Split out from
## make_get_variables so 'genmkfile deb-build-dep' (and friends) can run on a
## fresh system without build-essential, then install it from
## debian/control. dpkg-parsechangelog (which pulls in build-essential) is
## therefore only required for other targets.
make_get_dependencies() {
  ## sets: make_debian_control_file_relative_path
  ## sets: make_debian_control_file_absolute_path
  ## sets: dpkg_print_architecture
  # shellcheck source=./shared.bsh
  source "${GENMKFILE_PATH}/shared.bsh"
  make_shared_function

  ## Special repos opted in via make_use_git_describe_for_version
  ## have no debian/control; nothing to parse.
  if [ -z "${make_debian_control_file_absolute_path:-}" ]; then
    make_deb_build_dependencies=""
    make_deb_runtime_dependencies=""
    return 0
  fi

  ## Bootstrap dctrl-tools when missing. grep-dctrl (from dctrl-tools)
  ## is required to PARSE debian/control, so it cannot itself be
  ## listed in Build-Depends and self-bootstrapped through the
  ## normal deb-build-dep flow. On fresh CI images this leaves a
  ## chicken-and-egg: 'genmkfile deb-build-dep' fails immediately
  ## with "grep-dctrl not found". When running as root with apt-get
  ## available, install it transparently. Non-root invocations fall
  ## through to make_require below for the existing error path.
  if ! has grep-dctrl && [ "${EUID:-$(id -u)}" -eq 0 ] && has apt-get; then
    apt-get update --error-on=any
    apt-get install --yes --no-install-recommends dctrl-tools
  fi

  make_require grep-dctrl

  local raw_build_depends raw_runtime_depends
  raw_build_depends="$(grep-dctrl --show-field=Build-Depends --no-field-names '' "${make_debian_control_file_absolute_path}")"
  make_deb_build_dependencies="$(make_dependencies_filter_helper <<<"${raw_build_depends}")"

  raw_runtime_depends="$(grep-dctrl --show-field=Depends --no-field-names '' "${make_debian_control_file_absolute_path}")"
  make_deb_runtime_dependencies="$(make_dependencies_filter_helper <<<"${raw_runtime_depends}")"
}

## Returns 0 (true) if a debian/control 'Architecture:' field value covers the
## given target Debian architecture, i.e. dpkg-buildpackage building for that
## target produces a binary package for this stanza. Handles 'any', the
## 'linux-any' / 'linux-<arch>' wildcards (e.g. dkms packages), and explicit
## space-separated architecture lists. The architecture-independent value
## 'all' is handled separately by the caller.
make_architecture_covers_target() {
  local architecture_field="$1" target="$2" architecture_token
  ## $architecture_field is a space-separated list of Debian arch names/wildcards that must
  ## word-split. Match each with 'dpkg-architecture -i' (the target set as the host arch) rather
  ## than a hand-rolled case: it is the only correct matcher for wildcards. A pure-bash test cannot
  ## get 'any-<cpu>' right -- e.g. 'any-arm' matches armhf, whose CPU is 'arm' not 'armhf' -- so the
  ## old code silently dropped a covered package's .deb from make_package_debs_files_list.
  ## '-f' is REQUIRED: dpkg-architecture ignores '-a' when DEB_HOST_ARCH is already set in the
  ## environment (a cross-build, or after a prior 'eval $(dpkg-architecture -s)'), so without it
  ## the match reads the ENV arch, not ${target} -- dropping a covered .deb or inventing one.
  # shellcheck disable=SC2086
  for architecture_token in ${architecture_field}; do
    if dpkg-architecture -f -a "${target}" -i "${architecture_token}" 2>/dev/null; then
      return 0
    fi
  done
  return 1
}

## Split a Debian changelog version into epoch, upstream version and revision.
## Sets: make_epoch, make_pkg_version, make_pkg_revision. The revision keeps its
## leading hyphen because callers concatenate it straight into artifact names
## ('..._${make_pkg_version}${make_pkg_revision}_...').
##
## The revision is the part after the LAST hyphen, per Debian policy: an upstream
## version may itself contain hyphens. Splitting the revision on the FIRST hyphen
## while the version strips at the last one made the two halves disagree, so
## '1.0-beta-1' produced version '1.0-beta' plus revision '-beta-1' and every
## derived name ('.dsc', '.orig.tar.xz', '.changes') came out as '1.0-beta-beta-1'.
##
## Separated from make_get_variables so it can be exercised directly; see
## genmkfile-tests/test_version_parse.sh.
make_parse_changelog_version() {
  local changelog_version="$1"
  local temp

  if [[ "${changelog_version}" == *-* ]]; then
    make_pkg_revision="-${changelog_version##*-}"
    temp="${changelog_version%-*}"
  else
    make_pkg_revision=""
    temp="${changelog_version}"
  fi

  ## Parse version (strip epoch if present).
  make_pkg_version="${temp#*:}"

  ## Parse epoch (if present).
  if [[ "${changelog_version}" == *:* ]]; then
    make_epoch="${temp%:*}"
  else
    make_epoch=""
  fi
}

## Walk every binary-package stanza in debian/control via grep-dctrl and, for the current
## target architecture, append to the globals make_package_list (source name + every binary
## package name) and make_package_debs_files_list (the .deb path each binary produces),
## clearing all_package_debs_are_arch_all when any stanza builds architecture-dependent.
## Reads make_source_package_name / make_pkg_version / make_pkg_revision / target_architecture /
## DISTDIR / make_debian_control_file_absolute_path from the caller. A standalone function --
## not an inline block -- so genmkfile-tests can source and drive it directly. NOT named 'make_*'
## on purpose: make_parse_cmd dispatches 'make_<arg>', so a make_-prefixed helper would be callable
## as a bogus CLI target and would double-append to the (already-populated) globals.
parse_control_package_stanzas() {
  local package binary_package_architecture current_field line skip_debs_artifact
  local package_name_architecture continuation temp stanza_list
  ## grep-dctrl exits non-zero and emits only the stanzas parsed SO FAR on a malformed control (a
  ## line missing its colon after a valid stanza). A process substitution ('done < <(grep-dctrl)')
  ## would swallow that exit status -- the loop would read the truncated output and the build would
  ## SILENTLY drop the remaining binary packages. Capture to a temp (which preserves grep-dctrl's
  ## trailing blank, so the last stanza still commits) with an explicit rc check; a bad control
  ## aborts loud.
  stanza_list="$(mktemp)" || exit_with_error 1 "mktemp failed while parsing debian/control"
  if ! grep-dctrl --show-field=Package,Architecture '' "${make_debian_control_file_absolute_path}" > "${stanza_list}"; then
    safe-rm --force -- "${stanza_list}"
    exit_with_error 1 "parsing debian/control failed (grep-dctrl) -- malformed control?"
  fi
  package=""
  binary_package_architecture=""
  current_field=""
  while IFS= read -r line; do
    case "${line}" in
      "Package: "*)
        package="${line#Package: }"
        current_field="package"
        ;;
      "Architecture:"*)
        ## No required space after the colon: a BARE 'Architecture:' whose value is entirely on
        ## a continuation line must still set current_field, or the value is never associated.
        ## The leading blank ('Architecture: all') is stripped by the read-normalisation below.
        binary_package_architecture="${line#Architecture:}"
        current_field="architecture"
        ;;
      "")
        ## Normalise 'package' BEFORE the emptiness guard, then re-check on the normalised value.
        ## A folded 'Package:\n mypkg' arrives as ' mypkg'; grep-dctrl also emits a blank-only
        ## 'Package:' field as whitespace. Left unstripped the leading blank corrupts the
        ## make_package_list entry (reprepro remove/removesrc, deb-cleanup) and the expected .deb
        ## name; and a blank-only value MUST be treated as absent, not committed as an empty name
        ## -- an empty name makes deb-clean/deb-cleanup act on 'debian/' itself (test -d is true).
        read -r package <<<"${package}"
        if [ -z "${package}" ]; then
          ## Skip a stanza with no / blank-only Package:, but RESET the accumulator first: a bare
          ## 'continue' would keep this stanza's Architecture/field state and leak it into the
          ## NEXT stanza (which would then read a wrong architecture).
          binary_package_architecture=""
          current_field=""
          continue
        fi
        ## Normalise the (possibly folded) architecture value: strip leading/trailing blanks so
        ## a value that arrived only on a continuation line ('Architecture:\n all') still matches
        ## the exact '= all' test below; interior blanks are fine (that test aside, the value is
        ## word-split by make_architecture_covers_target).
        read -r binary_package_architecture <<<"${binary_package_architecture}"
        true "package: ${package}"
        true "make_pkg_version: ${make_pkg_version}"
        true "make_pkg_revision: ${make_pkg_revision}"
        true "binary_package_architecture: ${binary_package_architecture}"
        ## Determine the .deb architecture suffix and whether
        ## dpkg-buildpackage actually produces this binary for the current
        ## build (target) architecture.
        ##
        ## - 'Architecture: all' packages are architecture-independent and are
        ##   always built; the .deb keeps the 'all' suffix.
        ## - Architecture-dependent packages ('any', a 'linux-<arch>' wildcard
        ##   as used by e.g. tirdad-dkms, or an explicit architecture list) are
        ##   only built when the target architecture is covered, and the
        ##   resulting .deb is named after the target architecture.
        ## - Packages whose 'Architecture:' restriction excludes the target are
        ##   skipped, because dpkg-buildpackage emits no .deb for them and they
        ##   must not be listed as expected build artifacts. Example: an
        ##   'Architecture: amd64' microcode metapackage during an arm64 build.
        skip_debs_artifact="false"
        if [ "${binary_package_architecture}" = "all" ]; then
          package_name_architecture="all"
        elif make_architecture_covers_target "${binary_package_architecture}" "${target_architecture}"; then
          package_name_architecture="${target_architecture}"
          all_package_debs_are_arch_all="false"
        else
          ## dpkg-buildpackage produces no .deb for this stanza on this target,
          ## so do not record an expected artifact for it. Still add the binary
          ## package name to make_package_list below, so consumers that iterate
          ## it (reprepro remove/removesrc, deb-cleanup) continue to handle any
          ## stale copy -- reprepro remove/removesrc of an absent package is a
          ## no-op (exit 0), so this is safe.
          ##
          ## Leave all_package_debs_are_arch_all unchanged: an excluded stanza
          ## produces no architecture-dependent artifact for this target, so it
          ## must not force the per-architecture secondary build that the flag
          ## gates below. Only a stanza actually built as architecture-dependent
          ## (the 'elif' above) clears the flag.
          true "INFO: not expecting a .deb for binary package '${package}': Architecture '${binary_package_architecture}' does not cover target architecture '${target_architecture}'."
          skip_debs_artifact="true"
        fi
        if [ "${skip_debs_artifact}" = "false" ]; then
          ## Example architecture independent "all" package:
          ## anon-apt-sources-list_3.4-1_all.deb
          temp="${DISTDIR}/${package}_${make_pkg_version}${make_pkg_revision}_${package_name_architecture}.deb"
          make_package_debs_files_list+=("${temp}")
        fi
        if [ "${package}" != "${make_source_package_name}" ]; then
          make_package_list+=("${package}")
        fi
        package=""
        binary_package_architecture=""
        current_field=""
      ;;
      [[:blank:]]*)
        ## RFC822 folded continuation line (leading whitespace): append its value to the
        ## field the preceding header line started. Without this a multi-line 'Architecture:'
        ## silently loses every architecture after the first, so a covered target reads as
        ## uncovered and its expected .deb is dropped from make_package_debs_files_list.
        continuation="${line#"${line%%[![:blank:]]*}"}"
        case "${current_field}" in
          package)
            package="${package} ${continuation}"
            ;;
          architecture)
            binary_package_architecture="${binary_package_architecture} ${continuation}"
            ;;
        esac
      ;;
    esac
  done < "${stanza_list}"
  safe-rm --force -- "${stanza_list}"
}

make_get_variables() {
  ## Initialize the array if the caller did not set it (nounset-safe).
  [ -n "${make_folder_list_for_un_and_install+x}" ] || make_folder_list_for_un_and_install=()
  if [ "${#make_folder_list_for_un_and_install[@]}" -eq 0 ]; then
    make_folder_list_for_un_and_install=(bin boot dev etc home lib opt sbin srv sys usr var)
  fi

  local my_user_id
  my_user_id="$(id -u)"
  if [ "${my_user_id}" = "0" ]; then
    running_as_root_maybe="Running under account '${under}root${eunder}'. (uid '${my_user_id}')"
  else
    running_as_root_maybe="Running under account '${under}user${eunder}'. (uid '${my_user_id}')"
  fi

  ## Deterministic.
  LC_ALL=C.UTF-8
  TZ=UTC
  export LC_ALL TZ

  ## XXX: maybe better set dynamically but would that be deterministic?
  [ -n "${XZ_OPT:-}" ] || XZ_OPT="--threads=8"
  export XZ_OPT

  ## Skip dpkg-parsechangelog.
  ## make_get_dependencies short-circuits on empty
  ## make_debian_control_file_absolute_path.
  if [ "${make_use_git_describe_for_version:-}" = "true" ]; then
    ## make_get_dependencies runs make_shared_function, which sets
    ## make_debian_control_file_absolute_path (empty when there is no
    ## debian/control). The control-present check below branches on it.
    make_function_run make_get_dependencies

    ## Derive the git tag version from the nearest signed git tag (created
    ## as commit_<sha> by make_git_tag_sign) rather than from
    ## debian/changelog, so `genmkfile git-verify` / `git-tag` work for
    ## repos that tag by commit. This is independent of any deb version
    ## and is preserved even when the repo is also built as a .deb (see
    ## the control-present fall-through below).
    if ! make_git_tag_version_number="$(git describe --abbrev=0 2>/dev/null)"; then
      exit_with_error 1 "make_use_git_describe_for_version=true but no git tag reachable from HEAD; sign one with dm-quickgittagsign first."
    fi
    [ -n "${make_git_tag_version_number}" ] \
      || exit_with_error 1 "make_use_git_describe_for_version=true but 'git describe --abbrev=0' returned empty."
    make_git_tag_version_number="${make_git_tag_version_number}${make_git_tag_sign_appendix:-}"
    true "make_git_tag_version_number (from git describe): ${make_git_tag_version_number}"

    ## A repo with no debian/control has no deb to build. Blank the deb
    ## details variables and short-circuit. This is the original special-repo
    ## path (Whonix-Installer, Whonix-Starter,
    ## qubes-template-{kicksecure,whonix}, ...).
    if [ -z "${make_debian_control_file_absolute_path:-}" ]; then
      make_changelog_version=""
      make_pkg_revision=""
      make_pkg_version=""
      make_epoch=""
      make_pkg_version_with_revision=""

      ## Downstream make_git_tag_shared reads make_source_package_name
      ## under `set -o nounset` (just to check whether it equals
      ## "derivative-maker"). The regular branch sets it from
      ## `dpkg-parsechangelog --show-field Source`; for special repos
      ## there's no changelog, so use the repo's directory basename
      ## ("qubes-template-kicksecure", "Whonix-Installer", ...).
      make_source_package_name="$(basename -- "${PWD}")"
      make_package_list=("${make_source_package_name}")
      return 0
    fi

    ## Otherwise this repo opted into git-describe versioning but DOES
    ## ship debian/control (e.g. live-build) and is still built as a .deb
    ## via genmkfile. Fall through to the normal path below so the
    ## changelog version and the tarball / .dsc variables get set; the
    ## git-describe tag version computed above is kept (the changelog
    ## version assignment below is skipped while this flag is set).
  fi

  if ! has dpkg-parsechangelog; then
    exit_with_error 1 "dpkg-parsechangelog not found (provided by 'dpkg-dev'). Run: sudo genmkfile deb-build-dep"
  fi

  make_function_run make_get_dependencies

  make_debian_changelog_file_relative_path="debian/changelog"
  make_debian_changelog_file_absolute_path="$(realpath -- "${make_debian_changelog_file_relative_path}")"
  test -f "${make_debian_changelog_file_absolute_path}"

  ## Example make_changelog_version values:
  ##   3:0.1-1
  ##   0.1-1
  ##   1:20240810
  make_changelog_version="$(dpkg-parsechangelog --show-field Version)"

  make_parse_changelog_version "${make_changelog_version}"

  true "make_changelog_version: ${make_changelog_version}"
  true "make_pkg_revision: ${make_pkg_revision}"
  true "make_pkg_version: ${make_pkg_version}"
  true "make_epoch: ${make_epoch}"

  if [ -z "${make_pkg_version}" ]; then
    exit_with_error 1 "variable make_pkg_version is empty."
  fi

  make_pkg_version_with_revision="${make_pkg_version}${make_pkg_revision}"

  if [ "${make_use_git_describe_for_version:-}" = "true" ]; then
    ## Tag version already derived from git describe above (with the
    ## appendix applied there). Keep it; do not override with the
    ## changelog version. The tag scheme for these repos is commit_<sha>,
    ## so git-verify must compare against that, not the changelog version.
    true "make_git_tag_version_number (git describe, kept): ${make_git_tag_version_number}"
  else
    if [ "${make_pkg_use_pkg_version_without_revision_for_git_version:-}" = "true" ]; then
      ## used for derivative-maker
      make_git_tag_version_number="${make_pkg_version}"
    else
      ## default for all packages
      make_git_tag_version_number="${make_pkg_version_with_revision}"
    fi
    ## make_git_tag_sign_appendix gets set by dm-bump-derivative-maker-version
    make_git_tag_version_number="${make_git_tag_version_number}${make_git_tag_sign_appendix:-}"
  fi

  [ -n "${host_architecture:-}" ] || host_architecture="${dpkg_print_architecture}"
  [ -n "${target_architecture:-}" ] || target_architecture="${dpkg_print_architecture}"

  make_source_package_name="$(dpkg-parsechangelog --show-field Source)"
  ## Source package name may or may not match binary package name.
  make_package_list=("${make_source_package_name}")
  make_package_debs_files_list=()

  make_debian_non_package_specific_install_file_relative_path="debian/install"
  make_debian_install_file_relative_path="debian/${make_source_package_name}.install"

  ## Parse every binary-package stanza in debian/control (Package/Architecture, RFC822
  ## folding) into make_package_list + make_package_debs_files_list. A standalone function
  ## so the parser can be sourced and driven directly by genmkfile-tests.
  all_package_debs_are_arch_all="true"
  parse_control_package_stanzas

  true "make_package_list: ${make_package_list[*]}"
  true "make_package_debs_files_list: ${make_package_debs_files_list[*]}"

  package_is_trivially_cross_buildable="false"
  if [ "$(grep-dctrl -F Source -s X-Private-Trivially-Cross-Buildable -n '' "${make_debian_control_file_absolute_path}")" = "yes" ]; then
    package_is_trivially_cross_buildable="true"
  fi

  make_main_dsc_file_name="${make_source_package_name}_${make_pkg_version}${make_pkg_revision}.dsc"

  ## Changes file contains target_architecture such as 'amd64', not 'all'.
  ## Example changes file for architecture independent package:
  ## anon-apt-sources-list_3.4-1_amd64.changes
  make_main_dsc_file="${DISTDIR}/${make_main_dsc_file_name}"
  make_main_changes_file="${DISTDIR}/${make_source_package_name}_${make_pkg_version}${make_pkg_revision}_${target_architecture}.changes"

  make_debian_tarball_file_name="${make_source_package_name}_${make_pkg_version}${make_pkg_revision}.debian.tar.xz"
  make_debian_tarball="${DISTDIR}/${make_debian_tarball_file_name}"
  if [ "${make_debdist_tolower:-}" != "false" ]; then
    make_debian_tarball_file_name="${make_debian_tarball_file_name,,}"
    ## Lowercase only the file name (the package name must be lowercase),
    ## not DISTDIR: lowercasing the whole path breaks an uppercase DISTDIR.
    make_debian_tarball="${DISTDIR}/${make_debian_tarball_file_name}"
  fi
  make_debian_tarball_absolute_path="$(realpath -- "${make_debian_tarball}")"

  make_upstream_tarball_relative_path_file_name="${make_source_package_name}_${make_pkg_version}.orig.tar.xz"
  make_upstream_tarball_relative_path="${DISTDIR}/${make_upstream_tarball_relative_path_file_name}"
  if [ "${make_upstream_tarball_relative_path_tolower:-}" != "false" ]; then
    make_upstream_tarball_relative_path_file_name="${make_upstream_tarball_relative_path_file_name,,}"
    ## Lowercase only the file name, not DISTDIR (see make_debian_tarball above).
    make_upstream_tarball_relative_path="${DISTDIR}/${make_upstream_tarball_relative_path_file_name}"
  fi
  make_upstream_tarball_real_path="$(realpath -- "${make_upstream_tarball_relative_path}")"

  ## Exposed for consumption by override hook files.
  # shellcheck disable=SC2034
  make_upstream_tarball_source_folder_name="${make_source_package_name}-${make_pkg_version}"
}

make_get_destdir() {
  if [ -z "${DESTDIR:-}" ]; then
    DESTDIR="/"
  fi
  if type -t make_hook_at_the_end_of_get_destdir; then
    make_hook_at_the_end_of_get_destdir
  fi
}

make_get_distdir() {
  if [ -z "${DISTDIR:-}" ]; then
    DISTDIR=".."
  fi

  ## The cowbuilder dist folder only matters for a target that actually BUILDS
  ## or places dist artifacts. A non-dist action (git-*, help, deb-*-dep) sets
  ## make_enforce_cowbuilder_distdir=false so it is not forced to configure
  ## cowbuilder output it never writes -- DISTDIR just keeps its "../" default.
  ## Default true, so any other caller keeps the strict behaviour.
  if [ "${make_enforce_cowbuilder_distdir:-true}" = "true" ] \
     && [ "${make_use_cowbuilder:-}" = "true" ]; then
    if [ -z "${make_cowbuilder_dist_folder:-}" ]; then
      exit_with_error 1 "make_use_cowbuilder=${make_use_cowbuilder}, so environment variable make_cowbuilder_dist_folder needs to be set! For example:
make_use_cowbuilder=${make_use_cowbuilder} make_cowbuilder_dist_folder=~/genmkfile-packages-result"
    fi
    DISTDIR="${make_cowbuilder_dist_folder}"

    if ! test -d "${make_cowbuilder_dist_folder}"; then
      exit_with_error 1 "make_cowbuilder_dist_folder ${make_cowbuilder_dist_folder} does not exist! Run:
mkdir -p -- ${make_cowbuilder_dist_folder}"
    fi
  fi

  ## Only a dist-writing target (enforce) needs DISTDIR to exist + be writable.
  ## A non-dist action (git-tag-* / git-verify, deb-*-dep) uses DISTDIR only as a
  ## path prefix inside make_get_variables and never writes there, so a read-only
  ## package parent ('../') must not abort it.
  if [ "${make_enforce_cowbuilder_distdir:-true}" = "true" ]; then
    if ! test -d "${DISTDIR}"; then
      exit_with_error 1 "DISTDIR '${DISTDIR}' does not exist!"
    fi
    if ! test -w "${DISTDIR}"; then
      exit_with_error 1 "DISTDIR '${DISTDIR}' is not writeable!"
    fi
  fi
}

make_help() {
  set +x
  printf "%s\n" "\
genmkfile help
   Show this help.

genmkfile all
   Forwarded to 'make -f Makefile_orig all' when a Makefile_orig exists
   in the current directory, otherwise a no-op.

genmkfile test
   Dummy target. Exists only so debhelper can invoke it without
   failing; genmkfile does not run any tests itself.

genmkfile dist
   Create package-version.tar.xz from source files in \$DISTDIR (default \"..\").

genmkfile undist
   Delete package-version.tar.xz from source files in \$DISTDIR (default \"..\").

genmkfile debdist
   Create debian.tar.xz from source files in \$DISTDIR (default \"..\").

genmkfile undebdist
   Delete debian.tar.xz from source files in \$DISTDIR (default \"..\").

genmkfile debdsc
   Create the .dsc file in \$DISTDIR (default \"..\").

genmkfile undebdsc
   Delete the .dsc file in \$DISTDIR (default \"..\").

genmkfile debinstfile
   Create debian/pkg-name.install files.

genmkfile manpages
   Create man pages from the man source folder. Output is stored in auto-generated-man-pages folder.

genmkfile uch
   Store upstream changelog from git log in changelog.upstream.

genmkfile install
   Copy files from the source tree to system-wide directories.

genmkfile installsim
   Simulate copying files from the source tree to system-wide directories.

genmkfile deb-build-dep
   Install build dependencies listed in debian/control under Build-Depends using apt-get.
   Various environment variables are supported.

genmkfile deb-run-dep
   Install runtime dependencies listed in debian/control under Depends using apt-get.
   Various environment variables are supported.

genmkfile deb-all-dep
   Combination of deb-build-dep and deb-run-dep.

genmkfile deb-pkg-build
   Create a deb, which will be stored in the parent folder.

genmkfile deb-install
   Install deb from the parent folder.

genmkfile deb-pkg
   Combination of genmkfile deb-cleanup, dist, debdist, debdsc and deb-pkg-build.
   Builds a .deb (or source package) from scratch.

genmkfile deb-icup
   Combination of genmkfile deb-cleanup, deb-pkg-build, genmkfile deb-install and genmkfile deb-cleanup.
   icup stands for install and cleanup.

genmkfile deb-remove
   apt-get remove make_source_package_name

genmkfile deb-purge
   apt-get purge make_source_package_name

genmkfile deb-clean
   Delete temporary debhelper files.

genmkfile deb-cleanup
   Same as genmkfile deb-clean, and also deletes debuild artifacts from the parent folder.

genmkfile lintian
   Run lintian on the latest .changes file. Normally invoked
   automatically at the end of 'genmkfile deb-pkg-build'; exposed here
   for manual re-runs. Honours \$DEBUILD_LINTIAN_OPTS and
   \$make_lintian_fail_open_versus_closed.

genmkfile clean
   If a Makefile_orig exists, forward to 'make -f Makefile_orig clean',
   otherwise run 'make clean' if that target is defined.

genmkfile dput-ubuntu-ppa
   Upload to Ubuntu PPA. Requires a functional .dput.cf.

genmkfile distclean
   Currently the same as genmkfile clean.

genmkfile checkout
   Fetch from git.

genmkfile installcheck
   Check if source files match installed files.

genmkfile uninstallcheck
   Check if genmkfile uninstall removed all files.

genmkfile uninstall
   Delete all installed files.

genmkfile uninstallsim
   Simulate what genmkfile uninstall would do.

genmkfile deb-chl-bumpup-manual
   Manually bump the upstream version number in debian/changelog.

genmkfile deb-uachl-bumpup-manual
   Combination of genmkfile uch and genmkfile deb-chl-bumpup-manual.

genmkfile deb-chl-bumpup-major
   Major bump of the upstream version number in debian/changelog.

genmkfile deb-uachl-bumpup-major
   Combination of genmkfile uch and genmkfile deb-chl-bumpup-major.

genmkfile deb-uachl-commit-changelog
   git add debian/changelog (and changelog.upstream if present) and
   commit with a standard message.

genmkfile git-tag-show
   Echo the current git tag to stdout.

genmkfile git-tag-sign
   git tag (-s) sign latest pkg_version_with_revision from debian/changelog.
   Only a repository sanity check. Not for security purposes!

genmkfile git-tag-verify
   git tag (-v) verify latest pkg_version_with_revision from debian/changelog.
   Only a repository sanity check. Not for security purposes!

genmkfile git-tag-check
   Check if the current git tag is a signed git tag.
   Only a repository sanity check. Not for security purposes!

genmkfile git-commit-verify
   Check if the current git head is a signed git commit.
   Only a repository sanity check. Not for security purposes!

genmkfile git-verify
   Combination of tag-check and commit-verify.
   Only a repository sanity check. Not for security purposes!

genmkfile git-tag-push
   Atomic push of branches + tip tags to each listed remote, in
   parallel. Default: current branch + tag at HEAD -> 'origin'.
   Every listed branch tip must carry a tag.
   Environment variables:
     make_git_push_branches       space-separated branch list (unset -> current branch)
     make_git_push_remotes        space-separated remote list (unset -> origin)
     make_git_tag_push_cache_dir  cache root for skip-already-pushed (unset -> no cache)
   The caller is responsible for filtering make_git_push_branches /
   make_git_push_remotes to refs that exist locally; genmkfile errors
   out on a missing branch or remote.

genmkfile git-push
   Atomic push of branches (NO tags) to each listed remote, in
   parallel. Unsigned: unlike git-tag-push it requires no tag at the
   branch tip, so it is the path for dev/backup pushes. A remote whose
   LOCAL tracking ref already equals the tip is skipped with NO network
   call, so re-running (or a many-repo push loop like
   dm-packaging-helper-script) never hammers remotes into a rate-limit ban.
   Default: current branch -> 'origin'.
   Environment variables:
     make_git_push_branches       space-separated branch list (unset -> current branch)
     make_git_push_remotes        space-separated remote list (unset -> origin)
   The caller is responsible for filtering make_git_push_branches /
   make_git_push_remotes to refs that exist locally; genmkfile errors
   out on a missing branch or remote.

genmkfile git-tag-show-latest
   Echo the most recent git tag to stdout.

genmkfile reprepro-add
   Add the main deb package using the reprepro wrapper
   (Environment variable make_reprepro_wrapper defaults to 'reprepro'.)
   to the repository (Environment variable dist_build_apt_codename defaults to 'local'.)

   Example oldstable: dist_build_apt_codename=bookworm-developers genmkfile reprepro-add
   Example stable   : dist_build_apt_codename=trixie-developers genmkfile reprepro-add

genmkfile reprepro-remove
   Delete.

multiple architecture builds examples:

make_use_cowbuilder=true make_cross_build_platform_list='amd64 arm64' genmkfile deb-pkg
make_use_cowbuilder=true make_cross_build_platform_list='amd64' genmkfile deb-pkg"
}

make_all() {
  if test -f "${PWD}/Makefile_orig"; then
    make -f "${PWD}/Makefile_orig" all "$@"
  fi
}

make_dist() {
  local empty_directories msg

  make_require safe-rm strip-nondeterminism

  #find "." -not -iwholename '*.git*' -exec touch --no-dereference --date="Wed Sep 30 16:30:05 UTC 2015" {} +

  ## No longer using --transform because that does not work with symlinks.
  ## (Important for 'corridor' package.)

  if ! test -d "${DISTDIR}"; then
    exit_with_error 1 "DISTDIR '${DISTDIR}' does not exist!"
  fi
  if ! test -w "${DISTDIR}"; then
    exit_with_error 1 "DISTDIR '${DISTDIR}' is not writeable!"
  fi

  ## Debugging.
  test -w "${PWD}"
  touch -- "${make_upstream_tarball_real_path}"
  test -w "${make_upstream_tarball_real_path}"
  safe-rm -f -- "${make_upstream_tarball_real_path}"

  empty_directories="$(find "." -not -ipath '*.git*' -type d -empty)"

  if [ -n "${empty_directories}" ]; then
    exit_with_error 1 "Empty directory found! empty_directories:
'${empty_directories}'"
  fi

  make_output_debug "manual reproduction:
cd ${PWD}"

  ## Excluding '/debian' folder from upstream tarball to avoid lintian warning
  ## 'no-debian-changes'.

  msg="manual reproduction:
find \
      '.' \
      -not -path '*/\.git/*' \
      -not -path '*/\.git' \
      -not -name '.gitignore' \
      -not -path './debian*' \
      -print0 \
         | tar \
            --null \
            --no-recursion \
            --create \
            --owner=0 --group=0 --numeric-owner \
            --mode=go=rX,u+rw,a-s \
            --sort=name \
            --mtime='2015-10-21 00:00Z' \
            --xz \
            --file='${make_upstream_tarball_real_path}' \
            -T \
            -
   "

  msg="$(printf "%s\n" "${msg}" | sed 's/  */ /g')"
  make_output_debug "${msg}"

  find \
    '.' \
    -not -path '*/\.git/*' \
    -not -path '*/\.git' \
    -not -name '.gitignore' \
    -not -path './debian*' \
    -print0 |
    tar \
      --null \
      --no-recursion \
      --create \
      --owner=0 --group=0 --numeric-owner \
      --mode=go=rX,u+rw,a-s \
      --sort=name \
      --mtime='2015-10-21 00:00Z' \
      --xz \
      --file="${make_upstream_tarball_real_path}" \
      -T \
      -

  strip-nondeterminism -- "${make_upstream_tarball_real_path}"

  test -f "${make_upstream_tarball_real_path}"
}

make_debdist() {
  make_require strip-nondeterminism

  #find "." -not -iwholename '*.git*' -exec touch --no-dereference --date="Wed Sep 30 16:30:05 UTC 2015" {} +

  ## https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=657401
  ## Not using `dpkg-source` since that does not support any other output dir than '../'.

  find \
    debian \
    -print0 |
    tar \
      --null \
      --no-recursion \
      --create \
      --owner=0 --group=0 --numeric-owner \
      --mode=go=rX,u+rw,a-s \
      --sort=name \
      --mtime='2015-10-21 00:00Z' \
      --xz \
      --file="${make_debian_tarball_absolute_path}" \
      -T \
      -

  strip-nondeterminism -- "${make_debian_tarball_absolute_path}"

  test -f "${make_debian_tarball_absolute_path}"
}

make_undist() {
  make_require safe-rm
  safe-rm --force -- "${make_upstream_tarball_relative_path}"
}

make_debdsc() {
  make_require dpkg-source
  if ! test -d "${DISTDIR}"; then
    exit_with_error 1 "DISTDIR '${DISTDIR}' does not exist!"
  fi
  if ! test -w "${DISTDIR}"; then
    exit_with_error 1 "DISTDIR '${DISTDIR}' is not writeable!"
  fi

  pushd -- "${DISTDIR}" >/dev/null

  ## Creates make_main_dsc_file.
  make_log_and_run \
    dpkg-source \
    -c"${make_debian_control_file_absolute_path}" \
    -l"${make_debian_changelog_file_absolute_path}" \
    --format="3.0 (custom)" \
    --target-format="3.0 (quilt)" \
    -b / \
    "${make_upstream_tarball_real_path}" \
    "${make_debian_tarball_absolute_path}"

  popd >/dev/null

  test -f "${make_main_dsc_file}"
}

make_undebdsc() {
  make_require safe-rm
  safe-rm --force -- "${make_main_dsc_file}"
}

make_undebdist() {
  make_require safe-rm
  safe-rm --force -- "${make_debian_tarball_absolute_path}"
}

make_debinstfile() {
  ## Public target. The overwrite guards (an upstream debian/install; a hand-written
  ## debian/<pkg>.install carrying the 'nogenmkfile' opt-out) live in make_debinstfile_create,
  ## so a direct 'genmkfile debinstfile-create' cannot bypass them either.
  make_debinstfile_create
}

make_debinstfile_has_nogenmkfile_marker() {
  ## True if the install file carries the 'nogenmkfile' opt-out marker: a line whose sole
  ## meaningful content is 'nogenmkfile' -- a bare marker line, or a comment ('## nogenmkfile').
  ## A GENERATED entry is always a 'SOURCE => DEST' mapping (more than the bare token), so it
  ## never matches -- a path or a '#'-prefixed mapping that merely contains the substring (e.g.
  ## 'usr/bin/nogenmkfile', '#nogenmkfile#pkg => ...') does NOT trip the opt-out and freeze
  ## future updates.
  grep --quiet --extended-regexp -- '^[[:space:]]*#*[[:space:]]*nogenmkfile[[:space:]]*$' "$1"
}

make_debinstfile_create() {
  local new_file filename_without_dot filename_without_hash \
    cleaned_filename_without_hash pkg_name \
    filename_hash_dir filename_hash_base \
    temp_deb_install_file real_deb_install_file \
    file_name sorted_install_list
  local -a find_cmd install_records
  local -A delete_yet

  ## Overwrite guards, enforced HERE (not only in the make_debinstfile wrapper) so a direct
  ## 'genmkfile debinstfile-create' cannot clobber a maintainer-provided install file:
  ##  - an upstream debian/install (e.g. calamares-settings-debian) -- generating per-package
  ##    files alongside it makes dh ignore it and ship an EMPTY package;
  ##  - a 'nogenmkfile' marker in debian/<source>.install is a GLOBAL opt-out: it stops the
  ##    whole generation deliberately (a maintainer opting the package out entirely). A marker
  ##    in a NON-source binary package's debian/<binpkg>.install is a per-file opt-out, handled
  ##    in the multi-package loop below -- it preserves only that file, others still generate.
  if test -f "${make_debian_non_package_specific_install_file_relative_path:-}"; then
    return 0
  fi
  if test -f "${make_debian_install_file_relative_path:-}" \
     && make_debinstfile_has_nogenmkfile_marker "${make_debian_install_file_relative_path}"; then
    return 0
  fi

  make_require safe-rm sponge

  find_cmd+=(find)
  find_cmd+=(.)
  find_cmd+=(-not -path '*/\.git/*')
  find_cmd+=(-not -path '*/\.git')
  find_cmd+=(-not -name '.gitignore')
  find_cmd+=(-not -path './debian*')
  find_cmd+=(-iname '*#*')
  ## Files/symlinks only: a '#'-named DIRECTORY must not be emitted as an install
  ## entry (the '#' is the package delimiter, so such a dir is never a real target).
  find_cmd+=('(' -type f -o -type l ')')

  if "${find_cmd[@]}" | grep --fixed-strings -- '#' >/dev/null; then
    true "multi-package hash filename found: yes"
    find_cmd+=(-print0)

    ## Capture the file list to a temp with an EXPLICIT rc check (pipefail in a subshell so a
    ## find OR sort failure is caught), then read the loop from an in-memory array. Neither a
    ## pipe nor process substitution ('< <(find | sort)') exposes the producer's exit status --
    ## if find/sort dies AFTER partial output, the loop would accept the truncated list and the
    ## build would report success with a partial .install. Reading from the array (not a pipe)
    ## also keeps the loop in THIS shell, so exit_with_error on a bad package name stays fatal.
    sorted_install_list="$(mktemp)" \
      || exit_with_error 1 "mktemp failed while listing multi-package install files"
    if ! ( set -o pipefail; "${find_cmd[@]}" | LC_ALL='C' sort -z ) > "${sorted_install_list}"; then
      safe-rm --force -- "${sorted_install_list}"
      exit_with_error 1 "listing/sorting multi-package install files failed"
    fi
    mapfile -d '' -t install_records < "${sorted_install_list}"
    safe-rm --force -- "${sorted_install_list}"
    for file_name in "${install_records[@]}"; do
        filename_without_dot="${file_name#./}"
        ## Strip the '#<pkgname>' delimiter from the BASENAME only -- same basis as
        ## pkg_name below (after the basename's LAST '#'). Deriving the dest from the
        ## whole path ('${file_name%%#*}') truncated it at a '#' in a PARENT directory:
        ## 'us#r/bin/foo#pkg' yielded dest '/us' instead of '/us#r/bin/foo'.
        filename_hash_dir="${file_name%/*}"
        filename_hash_base="${file_name##*/}"
        filename_without_hash="${filename_hash_dir}/${filename_hash_base%#*}"
        cleaned_filename_without_hash="${filename_without_hash/#.\//\/}"
        ## The package name is the BASENAME's part after its last '#'. Deriving it from the
        ## whole path ('${file_name#*#}') let a PARENT directory containing '#..' inject '../'
        ## into temp_deb_install_file below -- an arbitrary-file write/delete OUTSIDE
        ## genmkfile_temp_dir (verified: a source tree with 'x#../pwned#pkg' escaped the temp
        ## dir as root). A basename cannot contain '/', and the value is validated besides.
        pkg_name="${file_name##*/}"
        pkg_name="${pkg_name##*#}"
        ## A leading dot is rejected too: a Debian package name cannot start with '.', and a
        ## '.pkg.install' would be silently skipped by the later '*.install' glob (dotglob off).
        case "${pkg_name}" in
          '' | *'/'* | '.'*)
            exit_with_error 1 "invalid package name '${pkg_name}' from multi-package filename '${file_name}' (expected '<path>#<pkgname>')"
            ;;
        esac
        temp_deb_install_file="${genmkfile_temp_dir}/${pkg_name}.install"

        if [ -z "${delete_yet[${pkg_name}]:-}" ]; then
          safe-rm --force -- "${temp_deb_install_file}"
          delete_yet["${pkg_name}"]=true
          printf "%s\n" "\
#!/usr/bin/dh-exec

## Copyright (C) 2020 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## This file was generated using 'genmkfile debinstfile'.
" | sponge -a -- "${temp_deb_install_file}"
          chmod -- +x "${temp_deb_install_file}"
        fi

        printf "%s\n" "${filename_without_dot} => ${cleaned_filename_without_hash}" | sponge -a -- "${temp_deb_install_file}"
    done

    for new_file in "${genmkfile_temp_dir}"/*.install; do
      real_deb_install_file="debian/${new_file##*/}"
      if test -f "${real_deb_install_file}"; then
        ## Per-target 'nogenmkfile' opt-out, same intent as the single-source-package
        ## guard above: a hand-maintained debian/<binary-pkg>.install carrying the marker
        ## is never overwritten. Without this, the multi-package loop clobbers EVERY
        ## differing binary-package install file, so a maintainer's hand-written content
        ## in a binary-package .install is silently lost.
        if make_debinstfile_has_nogenmkfile_marker "${real_deb_install_file}"; then
          continue
        fi
        if cmp -s -- "${new_file}" "${real_deb_install_file}"; then
          continue
        fi
      fi
      cp -- "${new_file}" "${real_deb_install_file}"
    done

  else
    true "multi-package hash filename found: no"
    temp_deb_install_file="${genmkfile_temp_dir}/pkg.install"
    real_deb_install_file="${make_debian_install_file_relative_path}"
    printf "%s\n" "\
## Copyright (C) 2020 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## This file was generated using 'genmkfile debinstfile'.
" | sponge -a -- "${temp_deb_install_file}"
    local d
    for d in "${make_folder_list_for_un_and_install[@]}"; do
      if test -d "${d}"; then
        printf "%s\n" "${d}/*" | sponge -a -- "${temp_deb_install_file}"
      fi
    done
    if cmp -s -- "${temp_deb_install_file}" "${real_deb_install_file}"; then
      return 0
    fi
    cp -- "${temp_deb_install_file}" "${real_deb_install_file}"
  fi
}

make_test() {
  ## Automatically run by debhelper. To prevent debhelper from failing,
  ## implemented a dummy function here.
  make_output_info "${FUNCNAME[0]} not implemented"
}

make_manpages() {
  shopt -s globstar dotglob nullglob
  local i filename_without_ronn_file_extension base_name
  make_require ronn
  for i in "${PWD}/man/"*".ronn"; do
    if test -d "${i}"; then
      continue
    fi

    base_name="${i##*/}"
    filename_without_ronn_file_extension="${base_name%.*}"

    mkdir --parents -- "${PWD}/auto-generated-man-pages"

    true "${bold}${cyan}${green}INFO:${reset} Creating man page ${PWD}/auto-generated-man-pages/${filename_without_ronn_file_extension} ${reset}"

    ## '--date=2020-01-01' for deterministic man pages.
    ronn \
      --date=2020-01-01 \
      --manual="${make_source_package_name} Manual" \
      --organization="${make_source_package_name}" \
      -- \
      <"${i}" \
      >"${PWD}/auto-generated-man-pages/${filename_without_ronn_file_extension}"

  done
  shopt -u globstar dotglob nullglob
}

make_uch() {
  if test -f "${PWD}/CHANGES"; then
    return 0
  fi
  make_require git sponge
  git log | \
    sed 's/[[:space:]]\+$//' | \
    stcat | \
    sponge -- "${PWD}/changelog.upstream"
  test -f "${PWD}/changelog.upstream"
  unicode-show "${PWD}/changelog.upstream"
}

make_distclean() {
  make_output_info "(internal) genmkfile distclean"
  make_function_run make_clean
}

make_clean() {
  if test -f "${PWD}/Makefile_orig"; then
    make -f "${PWD}/Makefile_orig" clean
  else
    if make --dry-run clean &>/dev/null; then
      make_output_info "(internal) make clean"
      make clean
    else
      make_output_info "no target 'make clean', ok."
    fi
  fi
}

make_deb_shared_dep() {
  local msg apt_get_exit_code

  make_require sudo apt-get

  msg="sudo apt-get ${DIST_APTGETOPT[*]} --yes --no-install-recommends --allow-downgrades install -- ${make_deb_shared_dependencies}"
  make_output_info "running: ${msg}"

  apt_get_exit_code="0"
  ## style-ok: allow-downgrades -- installing build-deps may need a downgrade to
  ## the pinned/frozen version (here and at the second apt-get); deliberate, not
  ## the vulnerability-introducing use R-212 targets.
  ## $make_deb_shared_dependencies is intentionally unquoted: the
  ## extractor produces a space-separated package list and apt-get
  ## expects one argument per package.
  # shellcheck disable=SC2086
  sudo \
    apt-get \
    "${DIST_APTGETOPT[@]}" \
    --yes \
    --no-install-recommends \
    --allow-downgrades \
    install \
    -- \
    ${make_deb_shared_dependencies} || apt_get_exit_code="$?"

  ## 'return', not 'exit' -- exiting the shell here used to abort
  ## chained targets (e.g. 'genmkfile deb-build-dep debinstfile'
  ## would stop after deb-build-dep even on success) and also skip
  ## make_deinit.
  return "${apt_get_exit_code}"
}

make_deb_build_dep() {
  ## 'build-essential' is implicitly assumed by every Debian source
  ## package; lintian emits 'build-depends-on-build-essential' if it
  ## is listed in debian/control Build-Depends. So we cannot put it
  ## there. To save users from having to install it by hand before
  ## running 'genmkfile deb-build-dep' for the first time, inject it
  ## here on top of whatever Build-Depends the extractor pulled from
  ## debian/control.
  ##
  ## make_get_dependencies needs grep-dctrl to parse debian/control,
  ## so any environment that ran us this far must keep it. Hardcoding
  ## here keeps the apt-install path explicit even if a future
  ## debian/control accidentally drops dctrl-tools from Build-Depends.
  local make_deb_shared_dependencies="build-essential dctrl-tools ${make_deb_build_dependencies}"
  make_function_run make_deb_shared_dep
}

make_deb_run_dep() {
  local make_deb_shared_dependencies="${make_deb_runtime_dependencies}"
  make_function_run make_deb_shared_dep
}

make_deb_all_dep() {
  ## See make_deb_build_dep for why build-essential and dctrl-tools
  ## are added here.
  local make_deb_shared_dependencies="build-essential dctrl-tools ${make_deb_build_dependencies} ${make_deb_runtime_dependencies}"
  make_function_run make_deb_shared_dep
}

make_deb_pkg_build_shared() {
  local cow_folder base_folder package
  local -a make_cowbuilder_config_file_arg=()

  ## See if we even need to do a build. Architecture-independent ('all')
  ## binaries are produced once, while targeting ${first_arch}; a secondary
  ## architecture only needs a build when this package emits at least one
  ## architecture-dependent binary. all_package_debs_are_arch_all is 'true'
  ## only when EVERY built binary is arch-all, so skip exactly that case on a
  ## non-first architecture. Skipping when the flag is 'false' would instead
  ## drop the architecture-dependent .deb for every secondary architecture.
  # shellcheck disable=SC2154  # first_arch is exported by the make-helper.bsh entrypoint
  if [ "${all_package_debs_are_arch_all}" = 'true' ] \
    && ! [ "${target_architecture}" = "${first_arch}" ]; then
    make_output_info "Skipping build because all binaries built by this package are arch-all and they have already been built."
    return 0
  fi

  if [ "${make_use_cowbuilder:-}" = "true" ]; then
    make_require sudo cowbuilder
    if ! test -f "${make_upstream_tarball_real_path}"; then
      exit_with_error 1 "upstream tarball ${make_upstream_tarball_real_path} does not exist.
Did you run
genmkfile dist && genmkfile debdist && genmkfile debdsc
beforehand?"
    fi

    if ! test -f "${make_debian_tarball_absolute_path}"; then
      exit_with_error 1 "debian tarball ${make_debian_tarball_absolute_path} does not exist.
Did you run
genmkfile dist && genmkfile debdist && genmkfile debdsc
beforehand?"
    fi

    if ! test -f "${make_main_dsc_file}"; then
      exit_with_error 1 "dsc file ${make_main_dsc_file} does not exist.
Did you run
genmkfile dist && genmkfile debdist && genmkfile debdsc
beforehand?"
    fi

    true "COWBUILDER_PREFIX: ${COWBUILDER_PREFIX:-}"

    if [ -n "${dist_build_apt_stable_release:-}" ]; then
      [ -n "${make_cowbuilder_distribution:-}" ] || make_cowbuilder_distribution="${dist_build_apt_stable_release}"
    elif [ -z "${make_cowbuilder_distribution:-}" ]; then
      make_require lsb_release
      make_cowbuilder_distribution="$(lsb_release --short --codename)"
    fi

    ## derivative-maker sets variable `make_cowbuilder_mirror`.

    if [ -n "${dist_build_apt_sources_mirror:-}" ]; then
      [ -n "${make_cowbuilder_mirror:-}" ] || make_cowbuilder_mirror="${dist_build_apt_sources_mirror}"
    else
      ## approx caching proxy support
      if [ "${APPROX_PROXY_ENABLE:-}" = "yes" ]; then
        ## TODO: Use the derivative-maker specific proxy at port 9977, or
        ## the system-wide proxy at port 9999?
        [ -n "${make_cowbuilder_mirror:-}" ] || make_cowbuilder_mirror="http://127.0.0.1:9977/debian"
      fi
      [ -n "${make_cowbuilder_mirror:-}" ] || make_cowbuilder_mirror="https://deb.debian.org/debian"
    fi

    ## Parent folder of the cowbuilder chroots. Honor '$cowbuilder_cache_dir'
    ## if the caller (e.g. derivative-maker) exported it, otherwise default to
    ## the cowbuilder standard location.
    [ -v cowbuilder_cache_dir ] || cowbuilder_cache_dir="/var/cache/pbuilder"
    ## '$make_cow_suffix' lets a caller give each concurrent 'deb-pkg' its own writable cow
    ## snapshot (e.g. '.0', '.1') so parallel package builds do not collide on one
    ## 'cow.cow_<arch>'. Empty by default -> unchanged single-build behavior. The read-only
    ## 'base.cow_<arch>' is shared safely (cowbuilder only reads it to seed each snapshot).
    cow_folder="${cowbuilder_cache_dir}/cow.cow_${target_architecture}${make_cow_suffix:-}"
    base_folder="${cowbuilder_cache_dir}/base.cow_${target_architecture}"

    ## Guard on readability, not just non-empty: a caller may point this at the dm-generated
    ## '~/derivative-binary/pbuilder.conf', which exists only AFTER a dm build has run. Skip
    ## '--configfile' when the file is absent rather than pass a path pbuilder aborts on
    ## sourcing -- so a standalone build needs no always-present wrapper configfile.
    if [ -n "${dist_build_pbuilder_config_file:-}" ] && [ -r "${dist_build_pbuilder_config_file}" ]; then
      make_cowbuilder_config_file_arg=(--configfile "${dist_build_pbuilder_config_file}")
    fi

    ## When building a package that contains both 'Architecture: any' and
    ## 'Architecture: all' binaries, we only want to keep the arch-all binaries
    ## built while targeting ${first_arch}. Otherwise the arch-all binaries
    ## may be built by an emulated architecture unnecessarily, which carries
    ## additional risks that we don't want.
    local build_result_dir
    build_result_dir="$(mktemp --directory --tmpdir="${genmkfile_temp_dir}" -- build_result_XXXXXX)"

    ## Using cowbuilder with
    ## --host-arch "$host_architecture" \
    ## --architecture "$dist_build_target_arch" \
    ## can cause the following build error:
    ## The following packages have unmet dependencies:
    ## builddeps:/build/anon-apps-config_3.0-1.dsc:amd64 : Depends: genmkfile:amd64 but it is not installable
    ##
    ## Test command:
    ## dist_build_pbuilder_config_file=/home/user/derivative-binary/pbuilder.conf make_cross_build_platform_list=arm64 make_cowbuilder_dist_folder=~/genmkfile-packages-result make_use_cowbuilder=true genmkfile deb-pkg

    ## Not using '--mirror' results in cowbuilder automatically passing to pbuilder:
    ## --mirror http://you-have-broken-debconf-configuration.example.com/
    ## Not using '--distribution' results in cowbuilder automatically passing to pbuilder:
    ## --distribution sid

    ## W: --override-config is not set; not updating apt.conf Read the manpage for details.
    ## https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1075960

    ## TODO: REPO_PROXY is no longer used, update this comment.
    ## COWBUILDER_PREFIX could set variables such as http_proxy.
    ## derivative-maker sets:
    ## COWBUILDER_PREFIX+=" env http_proxy=${REPO_PROXY}"
    ## which results in:
    ## sudo env http_proxy=http://127.0.0.1:9977 cowbuilder [...]
    ##
    ## creates $make_main_changes_file
    ##
    ## creates again (overwrites) $make_debian_tarball_file_name
    ##
    ## Forces the inclusion of the original source.
    ## --debbuildopts="-sa" is passed by cowbuilder to pdebuild (which passes
    ## it to debuild?) which passes it to dpkg-genchanges. In other words,
    ## results in 'dpkg-genchanges -sa'.
    ## That is required when make_pkg_revision is higher than 1. In that case
    ## by default the original source tarball would not be included by Debian
    ## default. The practice in Debian is not to upload the original source
    ## tarball if only the Debian package revision version number was
    ## increased since it would already be in the archive. That however seems
    ## incompatible with reprepro, which would show the following error:
    ## ##
    ## Unable to find pool/main/l/lkrg/lkrg_0.9.1.orig.tar.xz needed by lkrg_0.9.1-3.dsc!
    ## Perhaps you forgot to give dpkg-buildpackage the '-sa' option,
    ## or you could try --ignore=missingfile to guess possible files to use.
    ## There have been errors!
    ## ##
    ## Maybe non-ideal. '--debbuildopts="-sa" would only be required' if
    ## package revision number is higher than 1 and maybe only if there never
    ## has been package revision number 1 including upstream source tarball
    ## uploaded beforehand. Good enough.
    ##
    ## The temp-dir variables are cleared on the invocation below rather than left to
    ## the caller: pbuilder passes them into the chroot, where a host-only path does
    ## not exist. Cleared, not set to some other directory -- a private per-build temp
    ## dir is the same bug, since that path does not exist in the chroot either.
    ## Setting TMPDIR to a path absent from the chroot breaks pbuilder (which gets
    ## called by cowbuilder).
    ## Installing libpam-tmpdir (security-feature) results in these variables being set.
    ## In other words:
    ## "`sudo apt install libpam-tmpdir` breaks cowbuilder"
    ## https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=823651
    ## https://github.com/Kicksecure/security-misc/pull/147
    ## https://forums.whonix.org/t/make-symlink-attacks-and-other-tmp-based-attacks-harder-or-impossible-using-libpam-tmpdir/8488
    ## Installing libpam-tmpdir inside the grml-debootstrap chroot did fix a similar issue for grml-debootstrap / grub.
    ## https://github.com/grml/grml-debootstrap/issues/232
    ## Installing libpam-tmpdir inside the cowbuilder chroot did however not fix this issue.
    ## $COWBUILDER_PREFIX is intentionally unquoted: callers set it
    ## to something like 'env http_proxy=... env foo=bar' that needs
    ## to split into multiple argv slots.
    ##
    ## $UNSHARE_PID_NS (also intentionally unquoted) runs cowbuilder as the
    ## init of a private PID namespace so nothing started inside the chroot
    ## session can outlive the build. It is set and exported by
    ## derivative-maker 'help-steps/pre' (the single source of truth,
    ## typically 'unshare --pid --fork --kill-child --'); when genmkfile
    ## runs standalone it is unset and this expands to nothing, keeping
    ## unprivileged standalone builds working.

    local cowbuilder_target_architecture cowbuilder_host_architecture_maybe
    if [ "${package_is_trivially_cross_buildable}" = "true" ]; then
      ## --host-arch is, unintuitively, the architecture one is building a
      ## package for, **not** the architecture one is building package on.
      ## This is an artifact of compiler cross-build terminology. Therefore
      ## this is not a typo; the target architecture (which we pass to
      ## --architecture) is the architecture of the build host, while the
      ## "host" architecture is the architecture of the build target.
      cowbuilder_target_architecture="${host_architecture}"
      cowbuilder_host_architecture_maybe="--host-arch ${target_architecture}"
    else
      cowbuilder_target_architecture="${target_architecture}"
      cowbuilder_host_architecture_maybe=""
    fi

    # shellcheck disable=SC2086
    ## After 'sudo', not before: sudo's env_reset discards anything set on the calling
    ## side, so clearing these earlier would silently do nothing.
    make_log_and_run \
      sudo \
      env --unset=TMPDIR --unset=TMP --unset=TEMPDIR --unset=TEMP \
      ${COWBUILDER_PREFIX:-} \
      ${UNSHARE_PID_NS:-} \
      cowbuilder \
      --debbuildopts="-sa" \
      --architecture "${cowbuilder_target_architecture}" \
      ${cowbuilder_host_architecture_maybe} \
      "${make_cowbuilder_config_file_arg[@]}" \
      --build "${make_main_dsc_file}" \
      --basepath "${base_folder}" \
      --buildplace "${cow_folder}" \
      --distribution "${make_cowbuilder_distribution}" \
      --mirror "${make_cowbuilder_mirror}" \
      --extrapackages "${make_deb_build_dependencies}" \
      --buildresult "${build_result_dir}"

    if ! [ "${target_architecture}" = "${first_arch}" ]; then
      ## Drop the arch-all .debs a secondary build re-emitted; the copies kept
      ## while targeting ${first_arch} are authoritative. nullglob is not set
      ## here, so an unmatched glob would pass the literal pattern to safe-rm and
      ## abort the build under errexit -- a pure 'Architecture: any' package
      ## legitimately produces no '*_all.deb'. Collect real matches only.
      local arch_all_deb
      local -a arch_all_debs=()
      for arch_all_deb in "${build_result_dir}"/*_all.deb; do
        [ -e "${arch_all_deb}" ] || continue
        arch_all_debs+=( "${arch_all_deb}" )
      done
      if [ "${#arch_all_debs[@]}" -gt 0 ]; then
        safe-rm -- "${arch_all_debs[@]}"
      fi
    fi
    mv -- "${build_result_dir}"/* "${DISTDIR}/"
    safe-rm --recursive --force -- "${build_result_dir}"

  else
    make_require debuild dpkg-checkbuilddeps

    if [ "${target_architecture}" != "${dpkg_print_architecture}" ]; then
      make_output_warn "Cross-builds are only supported when using pbuilder! The package will be built for the build host's architecture."
    fi

    if ! dpkg-checkbuilddeps; then
      exit_with_error 1 "dpkg-checkbuilddeps reported missing build dependencies.
To install all dependencies, try running:
sudo genmkfile deb-all-dep"
    fi

    ## Using --no-lintian, because debuild does not exist with a non-zero exit
    ## code, should lintian find an error. Therefore running lintian afterwards.
    ## $make_debuild_maybe_unsigned_opts is a space-separated
    ## string like '-us -uc' that needs to word-split.
    # shellcheck disable=SC2086
    make_log_and_run \
      debuild \
      --no-lintian \
      -sa \
      ${make_debuild_maybe_unsigned_opts:-} \
      "$@"
  fi

  make_output_info "make_use_debsign: '${make_use_debsign:-}' | make_debsign_opts: '${make_debsign_opts:-}' | whoami: '$(whoami)' | DEBEMAIL: '${DEBEMAIL:-}'"
  if [ "${make_use_debsign:-}" = "true" ]; then
    make_require debsign sq
    deb_variables_check

    ## clearsign's $make_main_changes_file
    ## $make_debsign_opts is intentionally unquoted: user-supplied
    ## flags like '-k<keyid> --re-sign' must split into argv slots.
    # shellcheck disable=SC2086
    make_log_and_run debsign ${make_debsign_opts:-} "${make_main_changes_file}"

    ## sanity test
    #make_log_and_run gpg --verify "$make_main_changes_file"
    make_log_and_run sq verify --signer-email "${DEBEMAIL}" --cleartext "${make_main_changes_file}"

    #       ## Required, otherwise:
    #       ## dpkg-source: error: unpack target exists: /tmp/tmp.n1V3KXmMtI
    #       genmkfile_dpkg_source_test_extract_temp_dir="${genmkfile_temp_dir}/temp"
    #       ## Sanity test.
    #       ## Broken under Trixie, disabled. See:
    #       ## https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1110172
    #       ## TODO: consider re-enabling in Debian forky
    #       make_log_and_run \
    #         dpkg-source \
    #            --require-strong-checksums \
    #            --require-valid-signature \
    #            --extract \
    #            "$make_main_dsc_file" \
    #            "${genmkfile_dpkg_source_test_extract_temp_dir}/"
  fi

  for package in "${make_package_debs_files_list[@]}"; do
    if ! test -f "${package}"; then
      exit_with_error 1 "File '${package}' does not exist."
    fi
    make_output_info "You can find your deb file here: ${bold}${package}${reset}"
  done

  if [ "${make_use_lintian:-}" = "false" ]; then
    make_output_info "make_use_lintian=false - skipping lintian."
  elif [ "${make_use_lintian:-}" = "true" ]; then
    make_output_info "make_use_lintian=true - running lintian..."
    make_function_run make_lintian
  else
    make_output_info "make_use_lintian='' - Autodetecting if lintian is installed..."
    if has lintian; then
      make_output_info "lintian auto detected, using it..."
      make_function_run make_lintian
    else
      make_output_info "lintian not installed, skipping."
    fi
  fi
}

make_lintian_on_warning() {
  local lintian_exit_code="${1:-0}"
  if [ "${make_lintian_fail_open_versus_closed:-}" = "open" ]; then
    make_output_warn "lintian warning. make_lintian_fail_open_versus_closed=open - failing open."
    return 0
  fi
  make_output_error "\
lintian produced the output above and genmkfile fails closed on ANY of it. The default lintian
opts add --info/--display-info/--pedantic, so even a purely INFORMATIONAL ('N:') note aborts the
build here, not only a warning or error. To proceed, pick one:
  - fix the reported finding(s); or
  - build with 'make_lintian_fail_open_versus_closed=open' to WARN instead of fail; or
  - build with 'make_use_lintian=false' to skip lintian entirely."
  ## lintian may exit 0 while still emitting output; treat any output as a failure signal.
  [ "${lintian_exit_code}" = "0" ] && lintian_exit_code=1
  exit "${lintian_exit_code}"
}

make_lintian() {
  if ! test -f "${make_main_changes_file}"; then
    exit_with_error 1 "make_main_changes_file '${make_main_changes_file}' does not exist."
  fi
  if [ -z "${DEBUILD_LINTIAN_OPTS:-}" ]; then
    ## https://github.com/openwall/lkrg/pull/105
    ## --suppress-tags systemd-service-file-missing-documentation-key
    ##
    ## Building from git. Not from tarball.
    ## https://forums.whonix.org/t/end-to-end-signed-debs-debsign-debsig-and-dpkg-sig/3446
    ## --suppress-tags orig-tarball-missing-upstream-signature
    ##
    ## Removed '--suppress-tags package-supports-alternative-init-but-no-init.d-script' for Trixie, tag no longer exists.
    ##
    ## lintian's matcher only recognizes 'set -e' (and shebang '-e'), not the
    ## POSIX-equivalent 'set -o errexit' that our bash style (R-010) mandates,
    ## so any maintainer script using the strict preamble falsely trips
    ## 'maintainer-script-ignores-errors'. Suppress it globally.
    ## --suppress-tags maintainer-script-ignores-errors
    export DEBUILD_LINTIAN_OPTS="\
         --suppress-tags missing-tests-control \
         --suppress-tags systemd-service-file-missing-documentation-key \
         --suppress-tags orig-tarball-missing-upstream-signature \
         --suppress-tags no-manual-page \
         --suppress-tags maintainer-script-ignores-errors \
         --quiet \
         --pedantic \
         --info \
         --display-info \
         "
  fi
  local make_lintian_exit_code="0"
  local lintian_output
  make_output_info "running: lintian ${genmkfile_lintian_pre_opts:-} ${DEBUILD_LINTIAN_OPTS} ${genmkfile_lintian_post_opts:-} \"${make_main_changes_file}\""
  ## Capture the exit code in the parent shell. A previous idiom
  ## assigned it inside the $(...) subshell, where the assignment was
  ## thrown away when the subshell exited and the code was never seen.
  ## Lintian option vars are user-supplied multi-flag strings; leave
  ## them unquoted so they word-split into argv.
  # shellcheck disable=SC2086
  lintian_output="$(lintian ${genmkfile_lintian_pre_opts:-} ${DEBUILD_LINTIAN_OPTS} ${genmkfile_lintian_post_opts:-} "${make_main_changes_file}" 2>&1)" || make_lintian_exit_code="$?"
  if [ -n "${lintian_output}" ]; then
    if ! test -o xtrace; then
      make_output_info "lintian exit code: ${make_lintian_exit_code}"
      make_output_info "lintian output:"
      printf "%s\n" "################################################################################"
      printf "%s\n" "${lintian_output}"
      printf "%s\n" "################################################################################"
    fi
    make_lintian_on_warning "${make_lintian_exit_code}"
  fi
  if [ "${make_lintian_exit_code}" != "0" ]; then
    make_lintian_on_warning "${make_lintian_exit_code}"
  else
    make_output_info "lintian ok."
  fi
}

make_deb_pkg_build() {
  ## Local so make_deb_pkg_build_shared sees it via dynamic scoping
  ## without polluting the global namespace.
  local make_debuild_maybe_unsigned_opts="-us -uc"
  make_function_run make_deb_pkg_build_shared "$@"
}

make_deb_install() {
  local package
  make_require sudo apt-get
  for package in "${make_package_debs_files_list[@]}"; do
    if ! test -f "${package}"; then
      exit_with_error 1 "File '${package}' does not exist. Have you run 'genmkfile deb-pkg' already?"
    fi
  done
  ## '--reinstall' is required otherwise apt-get would refuse to install the package with the following error message:
  ## Note, selecting 'systemcheck' instead of '/home/user/derivative-binary/genmkfile-packages-result/systemcheck_25.1-1_all.deb'
  ## systemcheck is already the newest version (3:25.1-1).
  ## TODO: '--reinstall' does not fully fix this.
  make_log_and_run sudo \
    apt-get \
    "${DIST_APTGETOPT[@]}" \
    --yes \
    --no-install-recommends \
    --allow-downgrades \
    --reinstall \
    install \
    -- \
    "${make_package_debs_files_list[@]}"

  ## make_installcheck diffs the package's files at native FHS paths
  ## (bin/ etc/ usr/ ...) in the source tree against what was installed,
  ## which only fits genmkfile-native packages. A dh-packaged repo (e.g.
  ## live-build: source under share/, functions/, data/, mapped into the
  ## deb by debian/rules) has no such native-FHS files, so make_helper
  ## matches nothing and aborts with "Nothing has been copied". Let such
  ## a repo opt out via make_use_installcheck=false in its overrides.
  if [ "${make_use_installcheck:-}" = "false" ]; then
    make_output_info "make_use_installcheck=false - skipping installcheck."
  else
    make_function_run make_installcheck
  fi
}

make_deb_remove() {
  make_require sudo apt-get
  sudo apt-get --yes remove -- "${make_source_package_name}"
}

make_deb_purge() {
  make_require sudo apt-get
  sudo apt-get --yes purge -- "${make_source_package_name}"
}

make_dh_clean() {
  ## TODO: Executes arbitrary code from the working directory, is this safe?
  if test -x debian/rules; then
    debian/rules clean
  fi
}

make_deb_clean() {
  make_require safe-rm
  if test -d "debian/tmp"; then
    safe-rm --recursive -- "debian/tmp"
  fi
  if test -d "deb_dist"; then
    safe-rm --recursive -- "deb_dist"
  fi
  if test -d "debian/.debhelper"; then
    safe-rm --recursive -- "debian/.debhelper"
  fi
  if test -f "debian/autoreconf.after"; then
    safe-rm -- "debian/autoreconf.after"
  fi
  if test -f "debian/autoreconf.before"; then
    safe-rm -- "debian/autoreconf.before"
  fi
  local to_delete package
  for package in "${make_package_list[@]}"; do
    if test -d "debian/${package}"; then
      safe-rm --recursive -- "debian/${package}"
    fi
    for to_delete in \
      "debian/${package}.debhelper.log" \
      "debian/${package}.substvars" \
      "debian/files" \
      "debian/${package}.prerm.debhelper" \
      "debian/${package}.preinst.debhelper" \
      "debian/${package}.postinst.debhelper" \
      "debian/${package}.postrm.debhelper" \
      "debian/${package}.dkms.debhelper" \
      "debian/debhelper-build-stamp"; do
      if test -e "${to_delete}"; then
        safe-rm -- "${to_delete}"
      fi
    done
  done
}

## Python tooling (mypy, pytest, hypothesis) writes its caches into the
## directory it runs in, which for in-tree linting is the packaged source
## tree. Packaging copies the WORKING TREE, not git's view, so a directory
## that is already in .gitignore still ends up inside the .deb; lintian then
## fails the build closed on package-contains-python-dot-directory. Strip it
## here, since deb-cleanup runs before the tree is packaged.
## Each removal is logged: a silent sweep is indistinguishable from one that
## removed the wrong thing.
## No 'while read ... < <(find ...)': process substitution runs find in a
## subshell whose exit status is invisible, so under errexit a broken find
## would strip nothing and the build would continue looking clean. Running
## find in the foreground keeps its failure fatal.
## '-prune' on a match stops find descending into a directory it is about to
## delete, so nested residue cannot produce stale entries.
make_strip_build_residue() {
  make_require safe-rm find
  ## Refuse to sweep a tree that is not a package source root. The rest of this
  ## file also assumes PWD is the package root, but those functions delete a
  ## handful of specifically named artifacts; this one deletes RECURSIVELY, so
  ## running it from the wrong directory would remove every __pycache__ beneath
  ## it. Skip rather than abort: an unexpected context must not break a build,
  ## and the message says why nothing was stripped.
  if ! test -d "${PWD}/debian"; then
    make_output_info "no 'debian' directory in '${PWD}' - not a package source root, skipping build residue strip."
    return 0
  fi
  make_output_info "stripping build residue (removed paths listed below, if any)"
  ## -mindepth 1: never match "${PWD}" itself, so a package root that happens to BE named
  ## e.g. '__pycache__' is not handed to 'safe-rm -r' and wiped (the debian/ guard above
  ## does not exclude that case). The second alternative also takes a stray '.pyc'/'.pyo'
  ## (including a SYMLINK named so -- Python follows it) that lives OUTSIDE any cache dir,
  ## which the directory sweep alone would leave behind to mask edited source.
  find "${PWD}" \
    -mindepth 1 \
    -name ".git" -prune -o \
    -type d \
    \( -name ".mypy_cache" -o -name "__pycache__" -o -name ".hypothesis" \
       -o -name ".pytest_cache" \) \
    -print -prune -exec safe-rm -r -f -- {} + -o \
    \( -type f -o -type l \) \( -name "*.pyc" -o -name "*.pyo" \) \
    -print -exec safe-rm -f -- {} +
}

make_deb_cleanup() {
  local to_delete package
  make_require safe-rm
  make_function_run make_strip_build_residue
  make_function_run make_undist
  make_function_run make_undebdist
  make_function_run make_undebdsc
  make_function_run make_clean
  make_function_run make_dh_clean
  make_function_run make_deb_clean
  for package in "${make_package_list[@]}"; do
    ## No '-' in the version globs. A Debian revision is optional, and the upstream
    ## tarball is named from make_pkg_version WITHOUT the revision, so it never has
    ## one: requiring a hyphen meant '<pkg>_1.0.orig.tar.xz' matched nothing and every
    ## PREVIOUS version's tarball accumulated in DISTDIR -- the current one was removed
    ## only by the exact-path fallback below, which is what hid it. Revision-less
    ## versions ('<pkg>_2.0_all.deb') were likewise never swept, leaving a stale binary
    ## for a later build to publish or install.
    ##
    ## The leading '<pkg>_' still anchors each pattern, so a sibling package is
    ## untouched: '<pkg>-extra_1.0-1_all.deb' does not match '<pkg>_'*.
    for to_delete in \
      "${DISTDIR}/${package}_"*_*".deb" \
      "${DISTDIR}/${package}-dbgsym_"*_*".deb" \
      "${DISTDIR}/${package}_"*_*".buildinfo" \
      "${DISTDIR}/${package}_"*".debian.tar.xz" \
      "${DISTDIR}/${package}_"*".orig.tar.xz" \
      "${DISTDIR}/${package}_"*".dsc" \
      "${DISTDIR}/${package}_"*_*".build" \
      "${DISTDIR}/${package}_"*_*".changes" \
      "${DISTDIR}/${package}_"*"_source.build" \
      "${DISTDIR}/${package}_"*"_source.changes" \
      "${DISTDIR}/${package}_"*"_source.${package}.upload"; do
      if test -e "${to_delete}"; then
        safe-rm -- "${to_delete}"
      fi
    done
  done
  if test -f "${make_upstream_tarball_relative_path}"; then
    safe-rm -- "${make_upstream_tarball_relative_path}"
  fi
}

make_dput_ubuntu_ppa() {
  make_require dput
  dput "${make_source_package_name}" "${DISTDIR}/${make_source_package_name}_${make_pkg_version}${make_pkg_revision}_source.changes"
}

make_checkout() {
  make_require git
  git fetch
}

in_array() {
  local needle item
  needle="$1"
  shift
  true "INFO: in_array: @: |$*|"
  for item in "$@"; do
    true "INFO: in_array: item: ${item}"
    if [ "${item}" = "${needle}" ]; then
      true "INFO: in_array: found"
      return 0
    fi
  done
  true "INFO: in_array: not found"
  return 1
}

## True when <path> IS one of the remaining arguments, or lives underneath one of them.
##
## Used for 'folder_permission_skip_list': the question is "is this file inside a folder
## whose permissions we leave alone", which is a path-prefix question, not a substring
## one. 'array_match' answers the substring version, so a skip-list entry of '/usr/src'
## also matched '/usr/share/doc/x/usr/src-notes' and that file silently kept whatever
## mode it arrived with. Matching on the '/' boundary keeps the intended case
## ('/usr/src/foo') and drops the accidental one.
##
## array_match itself is left alone: it is generic, and a package's
## make-helper-overrides.bsh is sourced into this shell and may call it.
path_is_within_any() {
  local needle="$1" item
  shift
  for item in "$@"; do
    if [ "${needle}" = "${item}" ] || [[ "${needle}" == "${item}/"* ]]; then
      return 0
    fi
  done
  return 1
}

array_match() {
  local needle item
  needle="$1"
  shift
  true "INFO: array_match: @: |$*|"
  for item in "$@"; do
    true "item: ${item}"
    if [[ "${needle}" == *"${item}"* ]]; then
      true "INFO: array_match: found"
      return 0
    fi
  done
  true "INFO: array_match: not found"
  return 1
}

## True for an installed FILE at this path, including a dangling symlink, and false for
## a directory.
##
## 'test -f' follows the link and is therefore FALSE when the target is gone, so an
## uninstall keyed on it silently leaves the symlink behind and the following
## uninstallcheck reports success -- a false green on both steps.
##
## '-L' rather than '-e' for the second arm: '-e' is also true for a DIRECTORY, and the
## loop below hands each hit to safe-rm, which then fails with "Is a directory". The old
## '-f' excluded directories, and that part was right.
genmkfile_path_present() {
  [ -f "$1" ] || [ -L "$1" ]
}

make_helper() {
  shopt -s globstar dotglob nullglob
  local source_directory source_fso file_without_pwd file_with_destdir
  local still_installed="false"
  local fso_with_destdir_stat
  local genmkfile_rsync_opts folder_permission_skip_list

  make_require safe-rm rsync

  ## Mode flags are set by the wrappers (make_install, make_uninstall,
  ## ...) as bash locals, and dynamic scoping makes them visible here.
  ## Snapshot them into our own locals and default any unset flag to
  ## "false" so nounset keeps catching real logic errors. Using
  ## 'local' here (rather than bare assignment) means make_helper
  ## does not leak globals that could make a subsequent wrapper
  ## invocation see stale state.
  local make_install_="${make_install_:-false}"
  local make_installcheck_="${make_installcheck_:-false}"
  local make_installsim_="${make_installsim_:-false}"
  local make_uninstall_="${make_uninstall_:-false}"
  local make_uninstallcheck_="${make_uninstallcheck_:-false}"
  local make_uninstallsim_="${make_uninstallsim_:-false}"

  if ! test -d "${DESTDIR}"; then
    exit_with_error 1 "DESTDIR '${DESTDIR}' does not exist!"
  fi

  if [ "${make_installcheck_}" != "true" ]; then
    if ! test -w "${DESTDIR}"; then
      exit_with_error 1 "DESTDIR '${DESTDIR}' is not writeable!"
    fi
  fi

  genmkfile_rsync_opts=()

  ## Does not work.
  #genmkfile_rsync_opts+=("--chmod=o+r")
  #genmkfile_rsync_opts+=("--executability")

  genmkfile_rsync_opts+=("--recursive")     ## recurse into directories
  genmkfile_rsync_opts+=("--keep-dirlinks") ## treat symlinked dir on receiver as dir
  genmkfile_rsync_opts+=("--links")         ## copy symlinks as symlinks
  genmkfile_rsync_opts+=("--hard-links")    ## preserve hard links
  genmkfile_rsync_opts+=("--safe-links")    ## ignore symlinks that point outside the tree
  ## Never install build residue. 'make install' does not run
  ## make_strip_build_residue (only the 'deb' cleanup path does), so a source
  ## tree that accumulated a bytecode/tooling cache -- e.g. a package that ships
  ## '.py' with '-B' and never wants '.pyc' -- would otherwise get that cruft
  ## rsync'd straight into the target. Exclude the same set the strip removes.
  genmkfile_rsync_opts+=("--exclude=__pycache__")
  genmkfile_rsync_opts+=("--exclude=*.pyc")
  genmkfile_rsync_opts+=("--exclude=*.pyo")
  genmkfile_rsync_opts+=("--exclude=.mypy_cache")
  genmkfile_rsync_opts+=("--exclude=.pytest_cache")
  genmkfile_rsync_opts+=("--exclude=.hypothesis")
  #genmkfile_rsync_opts+=("--progress")
  #genmkfile_rsync_opts+=("--verbose")

  ## Cannot be `local` so hooks can increase it.
  #local genmkfile_file_has_been_copied
  [ -n "${genmkfile_file_has_been_copied:-}" ] || genmkfile_file_has_been_copied=false

  folder_permission_skip_list=()
  folder_permission_skip_list+=("/etc/sudoers.d")
  folder_permission_skip_list+=("/usr/src")

  if [ "${make_installsim_}" = "true" ]; then
    if ! test -d "${DESTDIR}"; then
      make_output_info "would create DESTDIR '${DESTDIR}': mkdir --parents -- '${DESTDIR}'"
    else
      make_output_info "No need to run, because folder DESTDIR '${DESTDIR}' already exists: mkdir --parents -- '${DESTDIR}'"
    fi
  fi

  for source_directory in "${make_folder_list_for_un_and_install[@]}"; do
    if ! test -d "${source_directory}"; then
      continue
    fi
    local rsync_done
    rsync_done=""
    for source_fso in "${PWD}/${source_directory}"/**; do
      genmkfile_file_has_been_copied=true
      file_without_pwd="${source_fso#"${PWD}"}"
      ## Issue: starts with double '//'
      #file_with_destdir="${DESTDIR}${file_without_pwd}"
      ## New: single '/'
      file_with_destdir="${DESTDIR%/}/${file_without_pwd#/}"
      if [ "${make_install_}" = "true" ]; then
        if ! test -d "${DESTDIR}"; then
          mkdir --parents -- "${DESTDIR}"
        fi
        if [ "${rsync_done}" != "true" ]; then
          ## Not using 'cp' because:
          #cp --recursive lib /
          # > cp: cannot overwrite non-directory '/lib' with directory 'lib'
          rsync "${genmkfile_rsync_opts[@]}" -- "${source_directory}" "${DESTDIR}"
          rsync_done=true
        fi

        ## TODO: review
        ## rsync (above) installed every source entry into DESTDIR EXCEPT
        ## symlinks that 'rsync --safe-links' drops - those point outside the
        ## copied tree (absolute, or via '..') and are silently NOT installed
        ## (there are no --exclude filters, so safe-links is the only thing that
        ## skips an entry). For a symlink source, decide from the link TARGETS,
        ## not from destination existence/type: on a reinstall/upgrade DESTDIR
        ## may already hold a stale file OR a stale symlink at this path, either
        ## of which would mask a dropped symlink. rsync copies a KEPT symlink
        ## verbatim, so the destination must be a symlink with the identical
        ## target; anything else (absent, a non-symlink, or a differently-aimed
        ## stale symlink) means rsync dropped this one -> fail loud, it is a
        ## packaging bug. (A non-symlink source whose destination is somehow
        ## missing falls through to 'stat' below and aborts under
        ## 'set -o errexit' - also loud.)
        if [ -L "${source_fso}" ]; then
          local source_fso_link_target destination_link_target
          source_fso_link_target="$(readlink -- "${source_fso}")"
          destination_link_target="$(readlink -- "${file_with_destdir}" 2>/dev/null || true)"
          if [ "${source_fso_link_target}" != "${destination_link_target}" ]; then
            exit_with_error 1 "refusing to install: symlink '${source_fso}' -> '${source_fso_link_target}' was not installed at '${file_with_destdir}'. A symlink pointing outside the copied tree (absolute, or via '..') is skipped by 'rsync --safe-links' -- make it a relative in-tree symlink."
          fi
          ## Destination is the copied symlink (identical target). A dangling in-tree symlink
          ## cannot be meaningfully chmod'ed (chmod follows to the missing target), so skip it
          ## rather than let the 'stat' below abort under errexit.
          if [ ! -e "${file_with_destdir}" ]; then
            continue
          fi
        fi

        ## Need to check first if it is a file...
        ## ...before checking if it is an executable.
        ## Because folders can also have executable bit.
        fso_with_destdir_stat="$(stat -c "%a" -- "${file_with_destdir}")"
        #echo "source_fso: $source_fso"
        if test -d "${source_fso}"; then
          if [ "${fso_with_destdir_stat}" != "755" ]; then
            if [ "${DESTDIR}" = "/" ]; then
              true "calling...: in_array |${file_without_pwd}| |${folder_permission_skip_list[*]}|"
              if ! in_array "${file_without_pwd}" "${folder_permission_skip_list[@]}"; then
                true "in_array did not match, therefore continuing..."
                make_output_info "chmod change on folder may be required, consider: chmod -- 755 '${file_with_destdir}'"
                ## Not safe due to folders such as '/etc/sudoers.d' which have chmod '700' as per Debian default.
                #chmod -- 755 "$file_with_destdir"
              fi
            fi
          fi
        elif test -f "${source_fso}"; then
          true "calling...: path_is_within_any |${file_without_pwd}| |${folder_permission_skip_list[*]}|"
          if ! path_is_within_any "${file_without_pwd}" "${folder_permission_skip_list[@]}"; then
            true "array_match did not match, therefore continuing..."
            ## CI workaround for tree-mode regressions. Some upstream
            ## push paths (notably the GitHub Contents API used by
            ## github-mcp-server's push_files / create_or_update_file)
            ## set every new tree entry to mode 100644 with no way to
            ## opt out, so an executable script can land in the git
            ## tree at 100644. `test -x "$source_fso"` then returns
            ## false here and the file installs as 0644, breaking any
            ## CI step that invokes it from PATH (rc=126, EACCES).
            ##
            ## Under CI=true (set by GitHub Actions), force +x for
            ## files installed under one of the conventional
            ## executable locations: /usr/bin, /usr/sbin, and the
            ## per-package /usr/libexec/<source-pkg-name>/. False
            ## positives (a sourced lib file gaining an exec bit it
            ## does not need) are functionally harmless: bash
            ## `source` does not consult the bit. Disable with
            ## GENMKFILE_CI_FORCE_EXEC=0.
            genmkfile_force_exec=false
            if [ "${CI:-}" = "true" ] \
              && [ "${GENMKFILE_CI_FORCE_EXEC:-1}" = "1" ]; then
              case "${file_without_pwd}" in
                /usr/bin/*|/usr/sbin/*|/usr/libexec/"${make_source_package_name:-__none__}"/*)
                  genmkfile_force_exec=true
                  ;;
              esac
            fi
            if test -x "${source_fso}" || [ "${genmkfile_force_exec}" = "true" ]; then
              if [ "${fso_with_destdir_stat}" != "755" ]; then
                make_output_info "chmod -- 755 '${file_with_destdir}' (executable, wrong mode)"
                chmod -- 755 "${file_with_destdir}"
              fi
            else
              if [ "${fso_with_destdir_stat}" != "644" ]; then
                make_output_info "chmod -- 644 '${file_with_destdir}' (non-executable, wrong mode)"
                chmod -- 644 "${file_with_destdir}"
              fi
            fi
          fi
        fi
      elif [ "${make_installsim_}" = "true" ]; then
        if [ "${rsync_done}" != "true" ]; then
          ## use '[*]' to treat as single line and avoid newlines in output
          make_output_info "would do: rsync --dry-run ${genmkfile_rsync_opts[*]} -- \"${source_directory}\" \"${DESTDIR}\""
          rsync --dry-run "${genmkfile_rsync_opts[@]}" -- "${source_directory}" "${DESTDIR}"
          rsync_done=true
        fi
        ## 'chmod' cannot be simulated because actually no file gets copied.
      elif [ "${make_uninstallcheck_}" = "true" ]; then
        if genmkfile_path_present "${file_with_destdir}"; then
          make_output_error "file '${file_with_destdir}' still installed."
          still_installed="true"
        fi
      elif [ "${make_installcheck_}" = "true" ]; then
        if test -f "${source_fso}"; then
          ## make_deb_install runs make_installcheck but configuration files may have changed on the system.
          ##
          ## TODO: How do we handle files in sudoers.d? (See also 'folder_permission_skip_list'.)
          ##       Run make_installcheck as root?
          ## diff: /etc/sudoers.d/pwfeedback: Permission denied
          if [ "/${source_directory}" = "/etc" ]; then
            diff -- "${source_fso}" "${file_with_destdir}" || make_output_info "'${file_with_destdir}' changed in /etc"
          elif [ "/${source_directory}" = "/usr/local/etc" ]; then
            diff -- "${source_fso}" "${file_with_destdir}" || make_output_info "'${file_with_destdir}' changed in /usr/local/etc"
          else
            diff -- "${source_fso}" "${file_with_destdir}"
          fi
        fi
      elif [ "${make_uninstallsim_}" = "true" ]; then
        if genmkfile_path_present "${file_with_destdir}"; then
          make_output_info "would do: safe-rm --verbose -- \"${file_with_destdir}\""
        fi
      elif [ "${make_uninstall_}" = "true" ]; then
        if genmkfile_path_present "${file_with_destdir}"; then
          safe-rm --verbose -- "${file_with_destdir}"
        fi
      else
        exit_with_error 1 "error 2 in ${FUNCNAME[0]}!"
      fi
    done
  done
  shopt -u globstar dotglob nullglob
  if [ "${still_installed}" = "true" ]; then
    exit 1
  fi
  if [ "${genmkfile_file_has_been_copied}" = "false" ]; then
    exit_with_error 1 "Nothing has been copied."
  fi
}

## Each of the six wrappers below sets its flag as a bash 'local' so it
## is visible to make_helper via dynamic scoping but does not leak to
## the global scope. Previously these were global assignments, which
## caused stale state: 'genmkfile install uninstall' left make_install_
## set to 'true' after the first call, so the second call saw *both*
## flags true, hit the earlier branch in make_helper's elif chain, and
## silently re-ran install instead of uninstalling.
make_install() {
  local make_install_="true"
  make_function_run make_helper
}

make_installcheck() {
  local make_installcheck_="true"
  make_function_run make_helper
}

make_installsim() {
  local make_installsim_="true"
  make_function_run make_helper
}

make_uninstallcheck() {
  local make_uninstallcheck_="true"
  make_function_run make_helper
}

make_uninstall() {
  local make_uninstall_="true"
  make_function_run make_helper
}

make_uninstallsim() {
  local make_uninstallsim_="true"
  make_function_run make_helper
}

make_deb_chl_bumpup_major() {
  local make_bump_type="major"
  make_function_run make_deb_chl_bumpup
}

make_deb_chl_bumpup_manual() {
  local make_bump_type="manual"
  make_function_run make_deb_chl_bumpup
}

make_deb_uachl_commit_changelog() {
  make_require git
  if test -f changelog.upstream; then
    git add -- changelog.upstream
  fi
  git add -- debian/changelog
  git commit -m "bumped changelog version"
}

make_deb_chl_bumpup() {
  make_require debchange bc
  deb_variables_check

  local new_upstream_version new_changelog_version new_revision revision_number

  if [ "${make_bump_type:-}" = "major" ]; then
    true "make_pkg_version: ${make_pkg_version}"

    if [ "${version_numbers_by_upstream:-}" = "true" ]; then
      ## Thanks to:
      ## https://stackoverflow.com/a/4485581
      #new_upstream_version="$(printf "%s\n" "$make_pkg_version" | awk -F. '{$NF = $NF + 1;} 1' | sed 's/ /./g')"
      new_upstream_version="${make_pkg_version}"
      ## make_pkg_revision carries its leading hyphen for artifact names, so it must
      ## be stripped before arithmetic: 'scale=9 ; -1 + 1' is 0, which turned a major
      ## bump of '1.0-1' into '1.0-0' -- a downgrade debchange rejects. Empty means a
      ## version with no revision at all, which bumps to 1.
      revision_number="${make_pkg_revision#-}"
      [ -n "${revision_number}" ] || revision_number=0
      new_revision="$(bc -l <<<"scale=9 ; ${revision_number} + 1" 2>&1)"
    else
      #new_upstream_version_without_epoch="$(bc -l <<< "scale=9 ; $make_pkg_version + 0.1" 2>&1)"
      #new_upstream_version="$(printf '%3.1f\n' "$new_upstream_version_without_epoch")"
      make_require "${GENMKFILE_PATH}/version-bump-calculate"
      new_upstream_version="$("${GENMKFILE_PATH}/version-bump-calculate" "${make_pkg_version}")"
      ## Packages by Kicksecure / Whonix always bump package version. Not Debian package revision.
      new_revision="1"
    fi

    if [ -z "${make_epoch}" ]; then
      new_changelog_version="${new_upstream_version}-${new_revision}"
    else
      new_changelog_version="${make_epoch}:${new_upstream_version}-${new_revision}"
    fi
  elif [ "${make_bump_type:-}" = "manual" ]; then
    make_output_info "Current version number: ${make_changelog_version}"
    make_output_info "Please enter new version number:"
    read -r new_changelog_version
  else
    exit_with_error 1 "make_bump_type '${make_bump_type:-}' is neither 'major' nor 'manual'."
  fi

  true "\
Bumping version from / to...
${make_changelog_version}
${new_changelog_version}"

  if [[ "${new_changelog_version}" == *error* ]]; then
    exit_with_error 1 "Failed!"
  fi

  [ -n "${DEBCHANGE_MSG:-}" ] || DEBCHANGE_MSG="New upstream version (local package)."

  make_log_and_run \
    debchange \
    --newversion "${new_changelog_version}" \
    "${DEBCHANGE_MSG}"

  make_log_and_run \
    debchange \
    --release \
    ""
}

make_deb_uachl_bumpup_manual() {
  make_function_run make_uch
  make_function_run make_deb_chl_bumpup_manual
}

make_deb_uachl_bumpup_major() {
  make_function_run make_uch
  make_function_run make_deb_chl_bumpup_major
}

make_git_tag_shared() {
  if [ "${make_git_tag_shared_done:-}" = "true" ]; then
    return 0
  fi
  if [ "${make_source_package_name}" = "derivative-maker" ]; then
    ## make_git_tag_sign_appendix gets set by dm-bump-derivative-maker-version
    if [ -z "${make_git_tag_sign_appendix:-}" ]; then
      exit_with_error 1 "package is '${make_source_package_name}' but variable make_git_tag_sign_appendix is empty."
    fi
  fi
  [ -n "${make_git_push_remotes:-}" ] || make_git_push_remotes="origin"
  make_require git
  make_git_tag_shared_done="true"
}

make_git_tag_show() {
  make_function_run make_git_tag_shared
  printf "%s\n" "${make_git_tag_version_number}"
}

make_git_tag_sign() {
  make_function_run make_git_tag_shared

  ## Special repos opted in via make_use_git_describe_for_version
  ## have no debian/changelog version that is potentially newer than
  ## any existing tag. We want to make a new, non-duplicate tag, so
  ## override make_git_tag_version_number with a "version" based on
  ## HEAD's commit hash and create a tag using that.
  if [ "${make_use_git_describe_for_version:-}" = "true" ]; then
    local head_sha
    head_sha="$(git rev-parse --verify HEAD)"
    make_git_tag_version_number="commit_${head_sha}"
    if git rev-parse --verify --quiet "refs/tags/${make_git_tag_version_number}" >/dev/null; then
      make_output_info "tag '${make_git_tag_version_number}' already exists at HEAD - no-op."
      return 0
    fi
  fi

  ## Refuse to create a tag that collides with an existing branch
  ## name. Tags and branches live in separate namespaces so git
  ## will happily create both, but afterwards every subsequent
  ## operation that takes a bare ref name ('git push origin X',
  ## 'git rev-parse X', ...) becomes ambiguous.
  if git show-ref --verify --quiet -- "refs/heads/${make_git_tag_version_number}"; then
    exit_with_error 1 "A branch named '${make_git_tag_version_number}' already exists. Refusing to create a tag with the same name; rename the branch or delete it first."
  fi

  make_log_and_run git tag -s -m "." -- "${make_git_tag_version_number}"

  make_function_run make_git_tag_verify
}

## FIXME: This function's name implies that it verifies a *tag*, and
## developer-meta-files uses it as such, but in practice it verifies
## the commit a tag points to. It should probably verify the actual
## tag instead. See corresponding TODO near
## developer-meta-files/usr/libexec/developer-meta-files/git-helpers.bsh
## function 'internal_git_verify_ref'.
make_git_tag_verify() {
  make_function_run make_git_tag_shared
  #make_log_and_run git verify-tag -- "$make_git_tag_version_number"
  ## 'sq-git' verifies a '[COMMIT_RANGE]'. Various contributors not listed
  ## in '$sq_git_policy_file' may have committed.
  ##
  ## NOTE: 'git rev-parse' does not support end-of-options ('--').
  ## Use 'refs/tags/...^{commit}' rather than a bare name so a
  ## same-named branch does not silently win the lookup.
  ## Pass the full tag ref to sq_git_run for the same reason.

  [ -n "${make_git_describe_output:-}" ] || make_git_describe_output="$(git describe --always --abbrev=1000000000)"

  if [ "${make_git_tag_version_number}" != "${make_git_describe_output}" ]; then
    if [ "${make_skip_git_describe_output_check:-}" != "true" ]; then
      exit_with_error 1 "Failed! Current git head is not at a signed tag! ${running_as_root_maybe} make_git_tag_version_number '${make_git_tag_version_number}' differs from make_git_describe_output '${make_git_describe_output}'"
    fi
  fi

  [ -n "${sq_git_trust_root:-}" ] || sq_git_trust_root="$(git rev-parse --verify "refs/tags/${make_git_tag_version_number}^{commit}")"

  sq_git_run "refs/tags/${make_git_tag_version_number}"
}

sq_git_run() {
  local cmd
  make_require sq-git
  ## XXX: hardcoded
  [ -n "${sq_git_trust_root:-}" ] || sq_git_trust_root="HEAD"
  ## XXX: hardcoded
  [ -n "${sq_git_policy_file:-}" ] || sq_git_policy_file="${HOME}/derivative-maker/buildconfig.d/openpgp-policy.toml"
  cmd=(sq-git log --policy-file "${sq_git_policy_file}" --trust-root "${sq_git_trust_root}" -- "${1}")
  make_output_info "running: ${cmd[*]}"
  ## Direct call (no make_function_run wrapper) so make_git_commit_verify
  ## can 'if ! sq_git_run "HEAD"' to catch failures and print a
  ## context-specific 'exit_with_error' message. make_function_run 'exit's on
  ## failure and would skip the if-branch.
  "${cmd[@]}"
}

make_git_tag_check() {
  make_function_run make_git_tag_shared

  ## Sanity test.
  #local make_git_describe_output
  ## dm-bump-derivative-maker-version script overrules this to disable this check.
  [ -n "${make_git_describe_output:-}" ] || make_git_describe_output="$(git describe --always --abbrev=1000000000)"
  if [ "${make_git_tag_version_number}" != "${make_git_describe_output}" ]; then
    if [ "${make_skip_git_describe_output_check:-}" != "true" ]; then
      exit_with_error 1 "Failed! Current git head is a untagged git commit! ${running_as_root_maybe} make_git_tag_version_number ${make_git_tag_version_number} differs from make_git_describe_output ${make_git_describe_output}"
    fi
  fi

  make_function_run make_git_tag_verify
  make_output_info "current git head is a signed git tag."
}

make_git_commit_verify() {
  make_function_run make_git_tag_shared
  ## Direct call (no make_function_run wrapper) so this if-branch can
  ## fire; make_function_run 'exit's on failure.
  if ! sq_git_run "HEAD"; then
    exit_with_error 1 "Failed! Current git head commit is unsigned! ${running_as_root_maybe}"
  fi
  make_output_info "current git head commit is signed."
}

make_git_verify() {
  make_function_run make_git_commit_verify
  make_function_run make_git_tag_check
  make_output_info "current git head is a signed git commit and a signed git tag."
}

## Push-cache. Opt-in via make_git_tag_push_cache_dir.
##
## Layout:
##   ${make_git_tag_push_cache_dir}/<repo>/<remote>.txt
##   Each line: <remote-url>:<tag>:<full-40-char-commit-sha>
##
## Including the remote URL in each line invalidates on 'git remote
## set-url' (stale entries stay in the file but won't match the new
## URL, so the push proceeds). Missing folders self-heal: fresh
## cache misses, every push proceeds, cache rebuilds.

git_tag_push_cache_path() {
  local remote repo_top repo_name

  remote="$1"

  [ -n "${make_git_tag_push_cache_dir:-}" ] || return 0

  repo_top="$(git rev-parse --show-toplevel)"
  repo_name="$(basename -- "${repo_top}")"

  printf "%s\n" "${make_git_tag_push_cache_dir}/${repo_name}/${remote}.txt"
}

git_tag_push_cache_check() {
  local remote tag sha cache_file remote_url

  remote="$1"
  tag="$2"
  sha="$3"

  cache_file="$(git_tag_push_cache_path "${remote}")"
  [ -n "${cache_file}" ] || return 1
  [ -f "${cache_file}" ] || return 1
  remote_url="$(git remote get-url -- "${remote}")"
  grep --line-regexp --fixed-strings --quiet -- "${remote_url}:${tag}:${sha}" "${cache_file}"
}

git_tag_push_cache_write() {
  local remote tag sha cache_file cache_dir remote_url

  remote="$1"
  tag="$2"
  sha="$3"

  cache_file="$(git_tag_push_cache_path "${remote}")"
  [ -n "${cache_file}" ] || return 0

  cache_dir="$(dirname -- "${cache_file}")"
  mkdir --parents -- "${cache_dir}"
  remote_url="$(git remote get-url -- "${remote}")"
  append-once "${cache_file}" "${remote_url}:${tag}:${sha}"
}

## Backgrounded (one per remote) by make_git_tag_push (branches + tags)
## and make_git_push (branches only): 'exit_with_error' kills only the sub-shell;
## parent's 'wait' aggregates per-remote failures. Args:
## <remote> <branch>... [-- <tag>...]. With no '--'/tags it pushes only
## the given branches. A branch already at the remote tip (per its LOCAL
## tracking ref -- no network) is skipped, so a many-repo push loop (e.g.
## dm-packaging-helper-script) never hammers up-to-date remotes into a ban.
git_push_to_remote() {
  local remote branch tag tag_sha local_sha tracking_ref arg sep_seen
  local -a branches tags tags_to_push refspecs

  remote="$1"
  shift

  branches=()
  tags=()
  sep_seen='false'
  for arg in "$@"; do
    if [ "${arg}" = '--' ]; then
      sep_seen='true'
      continue
    fi
    if [ "${sep_seen}" = 'true' ]; then
      tags+=( "${arg}" )
    else
      branches+=( "${arg}" )
    fi
  done

  tags_to_push=()
  for tag in "${tags[@]}"; do
    tag_sha="$(git rev-parse --verify "refs/tags/${tag}^{commit}")"
    if git_tag_push_cache_check "${remote}" "${tag}" "${tag_sha}"; then
      make_output_cached "tag '${tag}' (${tag_sha:0:12}) already pushed to '${remote}'"
    else
      tags_to_push+=( "${tag}" )
    fi
  done

  ## Skip a branch already at the remote tip using the LOCAL remote-tracking ref -- a pure local
  ## check, ZERO network round-trips. This is load-bearing when many repos are pushed in a loop
  ## (e.g. dm-packaging-helper-script pushes every derivative-maker package x N remotes each):
  ## contacting every remote just to decide there is nothing to push -- whether via 'git push'
  ## itself or an ls-remote pre-check -- would be hundreds of connections and risks a rate-limit
  ## BAN. So we must not touch the network to conclude "up to date".
  ## Deliberate tradeoff (do NOT "fix" this with ls-remote -- that reintroduces the hammering): the
  ## tracking ref can go stale if the remote url is repointed, or another checkout pushed the
  ## branch. Our writer (this bot, shared checkout) keeps it current in the normal path; the rare
  ## stale case (a skipped push until the local tip next advances) is accepted over banning.
  refspecs=()
  for branch in "${branches[@]}"; do
    local_sha="$(git rev-parse --verify "refs/heads/${branch}^{commit}")"
    tracking_ref="refs/remotes/${remote}/${branch}"
    if git show-ref --verify --quiet -- "${tracking_ref}" \
        && [ "$(git rev-parse --verify "${tracking_ref}^{commit}")" = "${local_sha}" ]; then
      make_output_cached "branch '${branch}' (${local_sha:0:12}) already at remote '${remote}' tip"
      continue
    fi
    refspecs+=( "refs/heads/${branch}:refs/heads/${branch}" )
  done
  for tag in "${tags_to_push[@]}"; do
    refspecs+=( "refs/tags/${tag}:refs/tags/${tag}" )
  done

  if [ "${#refspecs[@]}" -eq 0 ]; then
    make_output_cached "nothing to push to '${remote}' (all branches at remote tip, all tags cached)"
    return 0
  fi

  make_log_and_run git push --atomic --porcelain -- "${remote}" "${refspecs[@]}"

  for tag in "${tags_to_push[@]}"; do
    tag_sha="$(git rev-parse --verify "refs/tags/${tag}^{commit}")"
    git_tag_push_cache_write "${remote}" "${tag}" "${tag_sha}"
  done
}

## See 'genmkfile git-tag-push' help text above for the contract
## (env vars, default vs configured mode, strict-error rules).
make_git_tag_push() {
  local branch remote tag tags_at_tip current_branch unique_tags_raw
  local -a branches remotes all_tags unique_tags
  local -A push_label=()

  # shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/parallel.bsh
  source "${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/parallel.bsh"

  make_function_run make_git_tag_shared
  make_require append-once

  if [ -n "${make_git_push_branches:-}" ]; then
    ## Fold newlines to spaces first: read -a on a here-string stops at the first
    ## newline, so a newline-separated value silently drops all but line 1.
    read -r -a branches <<< "${make_git_push_branches//$'\n'/ }"
    [ "${#branches[@]}" -gt 0 ] \
      || exit_with_error 1 "make_git_push_branches is set but parses to an empty list (whitespace-only?)."
    for branch in "${branches[@]}"; do
      git show-ref --verify --quiet -- "refs/heads/${branch}" \
        || exit_with_error 1 "branch '${branch}' (from make_git_push_branches) does not exist in this repo."
    done
  else
    current_branch="$(git rev-parse --abbrev-ref HEAD)"
    [ "${current_branch}" != "HEAD" ] \
      || exit_with_error 1 "HEAD is detached; cannot determine current branch. Set make_git_push_branches or check out a branch."
    branches=( "${current_branch}" )
  fi

  ## Fold newlines to spaces first (e.g. make_git_push_remotes="$(git remote)"):
  ## read -a on a here-string stops at the first newline, silently dropping the rest.
  read -r -a remotes <<< "${make_git_push_remotes//$'\n'/ }"
  [ "${#remotes[@]}" -gt 0 ] \
    || exit_with_error 1 "make_git_push_remotes is set but parses to an empty list (whitespace-only?)."
  for remote in "${remotes[@]}"; do
    git remote get-url -- "${remote}" &>/dev/null \
      || exit_with_error 1 "remote '${remote}' (from make_git_push_remotes) does not exist in this repo."
  done

  all_tags=()
  for branch in "${branches[@]}"; do
    tags_at_tip="$(git tag --points-at "refs/heads/${branch}")"
    [ -n "${tags_at_tip}" ] \
      || exit_with_error 1 "no tag at tip of branch '${branch}'; create a signed tag at the tip before pushing."
    while IFS= read -r tag; do
      [ -n "${tag}" ] || continue
      all_tags+=( "${tag}" )
    done <<< "${tags_at_tip}"
  done

  unique_tags_raw="$(printf "%s\n" "${all_tags[@]}" | sort --unique)"
  mapfile -t unique_tags <<< "${unique_tags_raw}"

  for remote in "${remotes[@]}"; do
    git_push_to_remote "${remote}" "${branches[@]}" -- "${unique_tags[@]}" &
    # shellcheck disable=SC2034  # read by parallel_wait via nameref (shellcheck cannot see the source)
    push_label[$!]="${remote}"
  done

  # shellcheck disable=SC2154  # parallel_failures is set by parallel_wait (parallel.bsh)
  if ! parallel_wait push_label; then
    exit_with_error 1 "atomic push failed: branches=[${branches[*]}] tags=[${unique_tags[*]}] remote(s)=[${parallel_failures[*]}]"
  fi

  make_output_info "atomic push succeeded: branches=[${branches[*]}] tags=[${unique_tags[*]}] remotes=[${remotes[*]}]"
}

## See 'genmkfile git-push' help text above for the contract. Tag-less
## sibling of make_git_tag_push: no signed tag at tip is required, and
## no make_git_tag_shared version/package state is touched, so it runs
## in ANY repo. git_push_to_remote skips an up-to-date tip via the LOCAL
## tracking ref (no network), so re-running does not hammer remotes.
make_git_push() {
  local branch remote current_branch
  local -a branches remotes
  local -A push_label=()

  # shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/parallel.bsh
  source "${HELPER_SCRIPTS_PATH:-}/usr/libexec/helper-scripts/parallel.bsh"

  make_require git

  [ -n "${make_git_push_remotes:-}" ] || make_git_push_remotes="origin"

  if [ -n "${make_git_push_branches:-}" ]; then
    ## Fold newlines to spaces first: read -a on a here-string stops at the first
    ## newline, so a newline-separated value silently drops all but line 1.
    read -r -a branches <<< "${make_git_push_branches//$'\n'/ }"
    [ "${#branches[@]}" -gt 0 ] \
      || exit_with_error 1 "make_git_push_branches is set but parses to an empty list (whitespace-only?)."
    for branch in "${branches[@]}"; do
      git show-ref --verify --quiet -- "refs/heads/${branch}" \
        || exit_with_error 1 "branch '${branch}' (from make_git_push_branches) does not exist in this repo."
    done
  else
    current_branch="$(git rev-parse --abbrev-ref HEAD)"
    [ "${current_branch}" != "HEAD" ] \
      || exit_with_error 1 "HEAD is detached; cannot determine current branch. Set make_git_push_branches or check out a branch."
    branches=( "${current_branch}" )
  fi

  ## Fold newlines to spaces first (e.g. make_git_push_remotes="$(git remote)"):
  ## read -a on a here-string stops at the first newline, silently dropping the rest.
  read -r -a remotes <<< "${make_git_push_remotes//$'\n'/ }"
  [ "${#remotes[@]}" -gt 0 ] \
    || exit_with_error 1 "make_git_push_remotes is set but parses to an empty list (whitespace-only?)."
  for remote in "${remotes[@]}"; do
    git remote get-url -- "${remote}" &>/dev/null \
      || exit_with_error 1 "remote '${remote}' (from make_git_push_remotes) does not exist in this repo."
  done

  for remote in "${remotes[@]}"; do
    git_push_to_remote "${remote}" "${branches[@]}" &
    # shellcheck disable=SC2034  # read by parallel_wait via nameref (shellcheck cannot see the source)
    push_label[$!]="${remote}"
  done

  if ! parallel_wait push_label; then
    exit_with_error 1 "push failed: branches=[${branches[*]}] remote(s)=[${parallel_failures[*]}]"
  fi

  make_output_info "push succeeded: branches=[${branches[*]}] remotes=[${remotes[*]}]"
}

make_git_tag_show_latest() {
  make_function_run make_git_tag_shared
  ## Thanks to kilianc - http://stackoverflow.com/a/7979255/2605155
  local latest_tagged_commit make_git_tag_latest
  latest_tagged_commit="$(git rev-list --tags --max-count=1)"
  if [ -z "${latest_tagged_commit}" ]; then
    exit_with_error 1 "no tags exist in this repository."
  fi
  make_git_tag_latest="$(git describe --tags -- "${latest_tagged_commit}")"
  printf "%s\n" "${make_git_tag_latest}"
}

make_reprepro_shared() {
  local package make_reprepro_codename_list make_reprepro_codename_item changes_file_absolute_path

  ## global dist_build_apt_codename
  ## Can be set by derivative-maker.

  [ -n "${make_reprepro_wrapper:-}" ] || make_reprepro_wrapper="dm-reprepro-wrapper"
  make_require "${make_reprepro_wrapper}"

  if [ "${dist_build_apt_codename:-local}" = "local" ]; then
    make_reprepro_codename_list="local"
  else
    make_reprepro_codename_list="local ${dist_build_apt_codename}"
  fi

  for make_reprepro_codename_item in ${make_reprepro_codename_list}; do
    ## read by help-steps/variables
    export make_reprepro_codename_item

    ## $make_reprepro_wrapper is intentionally unquoted so that a
    ## wrapper set to e.g. 'dm-reprepro-wrapper --some-flag' splits
    ## correctly across the next four call sites.
    if [ "${make_reprepro_cmd}" = "add" ]; then
      changes_file_absolute_path="$(readlink -f -- "${make_main_changes_file}")"
      test -f "${changes_file_absolute_path}"
      ## An Architecture:all package ships a build-host buildinfo named
      ## '<pkg>_<build-arch>.buildinfo' (e.g. amd64), whose architecture is not in
      ## the .changes 'Architecture: all source' header. A distribution configured
      ## with 'Tracking: includebuildinfos' then rejects the include as
      ## 'surprisingarch'. Accept it (the standard handling for arch-all build
      ## metadata) so tracking-enabled repositories accept arch-all packages.
      # shellcheck disable=SC2086
      make_log_and_run ${make_reprepro_wrapper} --ignore=wrongdistribution --ignore=surprisingarch include "${make_reprepro_codename_item}" "${changes_file_absolute_path}"
    else
      for package in "${make_package_list[@]}"; do
        # shellcheck disable=SC2086
        make_log_and_run ${make_reprepro_wrapper} remove "${make_reprepro_codename_item}" "${package}"
        # shellcheck disable=SC2086
        make_log_and_run ${make_reprepro_wrapper} removesrc "${make_reprepro_codename_item}" "${package}"
        ## Avoid the following issue during the next package "include".
        # File "pool/main/a/anon-apt-sources-list/anon-apt-sources-list_6.5-1.dsc" is already registered with different checksums!
        # md5 expected: e6645bc3ef5cbb3769b8be0a008f8b01, got: 3142ef469a2bcab118dd772da437a80b
        # sha1 expected: 154a00a18c2d60d4d10148abab5ce809e85cbe86, got: b6da54d5d481180adf5298cd031e7381bf7253ba
        # sha256 expected: c5312451a92bda546a4d8e4331f835fecf1dbc07ebf99f21d67eab9e5082967d, got: 6a2f2d3aaba452659385a7727c246e45dfbb76af40a98278912a3a1d3c8563c8
        # There have been errors!'
        # shellcheck disable=SC2086
        make_log_and_run ${make_reprepro_wrapper} deleteunreferenced
        ## Results in:
        # deleting and forgetting pool/main/a/anon-apt-sources-list/anon-apt-sources-list_6.5-1.debian.tar.xz
        # deleting and forgetting pool/main/a/anon-apt-sources-list/anon-apt-sources-list_6.5-1.dsc
        # deleting and forgetting pool/main/a/anon-apt-sources-list/anon-apt-sources-list_6.5-1_all.deb
        # deleting and forgetting pool/main/a/anon-apt-sources-list/anon-apt-sources-list_6.5.orig.tar.xz
      done
    fi
  done
}

make_reprepro_add() {
  local make_reprepro_cmd=add
  make_function_run make_reprepro_shared
}

make_reprepro_remove() {
  local make_reprepro_cmd=remove
  make_function_run make_reprepro_shared
}

make_source_overrides_file() {
  ## style-ok: allow-sc1091-disable -- the make-helper-overrides.bsh files below
  ## are OPTIONAL per-project hooks that are legitimately absent in an isolated
  ## checkout, so shellcheck cannot follow them.
  if test -x "./make-helper-overrides.bsh"; then
    bash -n "./make-helper-overrides.bsh"
    # shellcheck disable=SC1091  # optional per-project override, absent in an isolated checkout
    source "./make-helper-overrides.bsh"
  fi
  if test -x "./debian/make-helper-overrides.bsh"; then
    bash -n "./debian/make-helper-overrides.bsh"
    # shellcheck disable=SC1091  # optional per-project override, absent in an isolated checkout
    source "./debian/make-helper-overrides.bsh"
  fi
}

make_source_overrides_folder() {
  local folder_name i
  for folder_name in ./make-helper-overrides.d ./debian/make-helper-overrides.d; do
    if test -d "${folder_name}"; then
      for i in "${folder_name}"/*; do
        if test -x "${i}"; then
          ## If the last character is a ~, ignore that file,
          ## because it was created by some editor,
          ## which creates backup files.
          if [[ "${i}" == *'~' ]]; then
            continue
          fi
          ## Skipping files such as .dpkg-old and .dpkg-dist.
          if [[ "${i}" == *'.dpkg-'* ]]; then
            true "skip: ${i}"
            continue
          fi
          bash -n "${i}"
          # shellcheck disable=SC1090
          source "${i}"
        fi
      done
    fi
  done
}

make_function_run() {
  local function_name
  function_name="$1"
  shift

  if [ "${function_name}" = "make_helper" ]; then
    true "${FUNCNAME[0]}: ${function_name}"
  else
    make_output_info "${FUNCNAME[0]}: ${function_name}"
  fi
  if type -t "${function_name}_hook_pre" >/dev/null; then
    "${function_name}_hook_pre" "$@"
  fi
  "${function_name}" "$@"
  if type -t "${function_name}_hook_post" >/dev/null; then
    "${function_name}_hook_post" "$@"
  fi
}

if was_executed "${BASH_SOURCE[0]}"; then
  if test -f "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/pre.bsh; then
    ## pre.bsh would `source` the following folders:
    ## /etc/make-helper-one.bsh_pre.d/*.conf
    ## /usr/local/etc/make-helper-one.bsh_pre.d/*.conf
    # shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/pre.bsh
    source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/pre.bsh
  fi

  ## Color variables are set by pre.bsh if available; default to empty
  ## strings so printf calls do not fail under nounset.
  : "${red:=}" "${green:=}" "${bold:=}" "${reset:=}" \
    "${cyan:=}" "${under:=}" "${eunder:=}"

  temp="$*"
  if [ -z "${temp}" ]; then
    make_output_info "called without parameters."
  else
    make_output_info "command: $*"
  fi

  set -o errexit
  set -o nounset
  set -o pipefail
  set -o errtrace
  shopt -s inherit_errexit
  shopt -s shift_verbose

  if [ -n "${DIST_APTGETOPT_SERIALIZED:-}" ]; then
    mapfile -t DIST_APTGETOPT <<<"${DIST_APTGETOPT_SERIALIZED}"
  else
    DIST_APTGETOPT=()
  fi

  make_function_run make_init

  make_function_run make_source_overrides_file "$@"
  make_function_run make_source_overrides_folder "$@"

  ## Classify the requested target(s) so a NON-COWBUILDER action never trips on
  ## cowbuilder config it does not use:
  ##  - __needs_distdir      run make_get_distdir/destdir (set DISTDIR/DESTDIR).
  ##  - __enforce_cowbuilder additionally REQUIRE + redirect to the cowbuilder
  ##                         dist folder -- only a real build/dist target does.
  ##  - __needs_version_info parse debian/control + dpkg-parsechangelog
  ##                         (make_source_package_name, versions, ...); dpkg-dev
  ##                         may be absent on a fresh system.
  ##  - __needs_dependencies parse Build-Depends / Depends only.
  ## git-push is fully standalone; help/test are query/dummy -> none of these.
  ## The git-tag-* / git-verify family needs make_source_package_name
  ## (make_get_variables) but never builds with cowbuilder, so it sets DISTDIR at
  ## its default WITHOUT the cowbuilder-folder requirement. deb-*-dep only
  ## resolves dependencies. Everything else keeps the conservative default:
  ## DISTDIR set AND cowbuilder enforced.
  __needs_distdir=false
  __enforce_cowbuilder=false
  __needs_version_info=false
  __needs_dependencies=false
  for __arg in "$@"; do
    case "${__arg}" in
    git-push | help | test | '' | --)
      ## Non-targets ('' / end-of-options) and pure query/dummy targets need no
      ## DISTDIR, version info, or cowbuilder folder.
      ;;
    git-tag-push | git-tag-show | git-tag-show-latest | git-tag-sign \
      | git-tag-verify | git-tag-check | git-commit-verify | git-verify)
      __needs_distdir=true
      __needs_version_info=true
      ;;
    deb-build-dep | deb-run-dep | deb-all-dep)
      __needs_distdir=true
      __needs_dependencies=true
      ;;
    *)
      __needs_distdir=true
      __enforce_cowbuilder=true
      __needs_version_info=true
      ;;
    esac
  done
  ## No arguments falls through to make_all in make_parse_cmd; treat it
  ## like any other build target.
  [ $# -eq 0 ] && { __needs_distdir=true; __enforce_cowbuilder=true; __needs_version_info=true; }

  if [ "${__needs_distdir}" = "true" ]; then
    make_enforce_cowbuilder_distdir="${__enforce_cowbuilder}"
    make_function_run make_get_distdir
    make_function_run make_get_destdir
  fi

  if [ "${__needs_version_info}" = "true" ]; then
    make_function_run make_get_variables
  elif [ "${__needs_dependencies}" = "true" ]; then
    make_function_run make_get_dependencies
  fi
  unset __arg __needs_distdir __enforce_cowbuilder __needs_version_info \
    __needs_dependencies make_enforce_cowbuilder_distdir

  make_function_run make_parse_cmd "$@"
  make_function_run make_deinit

  true "$0: END"
fi
